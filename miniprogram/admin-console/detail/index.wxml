<view class="admin-page">
  <text class="eyebrow">{{title}}</text><text class="title">{{recordTitle || '记录详情'}}</text>
  <view wx:if="{{loading}}" class="admin-card empty">正在读取最新详情…</view>
  <view wx:if="{{error}}" class="admin-card error" aria-live="polite">{{error}}</view><text wx:if="{{notice}}" class="notice">{{notice}}</text>
  <view wx:if="{{pendingRetry}}" class="admin-card"><text class="section-title">操作结果待确认</text><text class="muted">当前操作内容已锁定，重试复用原编号。</text><button class="primary" bindtap="retryWrite" loading="{{writing}}" disabled="{{writing || preparing}}">重试原操作</button></view>
  <view wx:if="{{ready}}" class="admin-card"><view wx:for="{{fields}}" wx:key="label" class="field"><text class="label">{{item.label}}</text><text class="value">{{item.value}}</text></view></view>
  <block wx:if="{{ready && resource === 'services'}}">
    <view class="admin-card"><text class="section-title">已购人工服务权益</text><view wx:for="{{servicePackages}}" wx:key="id" class="service-package"><text class="form-label">{{item.planTitle}} · {{item.statusLabel}}</text><text class="muted">订单 {{item.orderNo}}</text><text class="muted">剩余 {{item.remainingCount}} / {{item.totalCount}} 次 · 已用 {{item.usedCount}} 次</text><text class="muted">到期 {{item.expireAt}}</text></view></view>
    <view wx:if="{{canAssign || extendPackages.length}}" class="admin-card"><text class="section-title">平台服务处理</text><text class="form-label">处理原因（必填；延期须说明平台延误）</text><textarea value="{{serviceReason}}" maxlength="500" data-field="serviceReason" bindinput="onFieldInput" placeholder="记录分配依据或平台延误原因" disabled="{{preparing || writing || pendingRetry}}"/>
      <block wx:if="{{canAssign}}"><text class="form-label">{{hasExistingAssignment ? '更换负责主理人' : '分配负责主理人'}}</text><picker range="{{principalOptions}}" range-key="label" value="{{principalIndex}}" data-field="principalIndex" bindchange="onChoice" disabled="{{preparing || writing || pendingRetry}}"><view class="picker">{{principalOptions[principalIndex].label}}<text>⌄</text></view></picker><text wx:if="{{hasExistingAssignment}}" class="muted">提交前会明确确认更换已有服务关系。</text><button class="primary" data-command="assign" bindtap="prepareWrite" disabled="{{preparing || writing || pendingRetry}}">{{hasExistingAssignment ? '核对并更换主理人' : '核对并分配主理人'}}</button></block>
      <block wx:if="{{extendPackages.length}}"><text class="form-label">平台延误延期</text><picker range="{{extendPackages}}" range-key="label" value="{{packageIndex}}" data-field="packageIndex" bindchange="onChoice" disabled="{{preparing || writing || pendingRetry}}"><view class="picker">{{extendPackages[packageIndex].label}}<text>⌄</text></view></picker><input class="form-input" value="{{extensionDays}}" type="number" maxlength="2" data-field="extensionDays" bindinput="onFieldInput" placeholder="延长天数，1至30整数天" disabled="{{preparing || writing || pendingRetry}}"/><text class="muted">按现有到期日累加；过期权益增加天数后可能仍已过期。退款及次数耗尽的权益不能延期。</text><button class="secondary" data-command="extend" bindtap="prepareWrite" disabled="{{preparing || writing || pendingRetry}}">核对延期到期日</button></block>
      <text wx:if="{{preparing || writing}}" class="muted">正在核对并提交，请勿重复点击…</text>
    </view>
  </block>
  <view wx:if="{{ready && resource === 'certifications'}}" class="admin-card">
    <text class="section-title">受控核验材料</text><text class="muted">仅供当前申请核验，请勿截屏或另行保存。</text>
    <button class="secondary" bindtap="viewEvidence" loading="{{evidenceLoading}}" disabled="{{preparing || writing || pendingRetry}}">查看核验码与申报信息</button>
    <view wx:for="{{evidenceFields}}" wx:key="label" class="field"><text class="label">{{item.label}}</text><text class="value">{{item.value}}</text></view><button wx:if="{{evidenceFields.length}}" class="text-button" bindtap="clearEvidence">关闭核验信息</button>
    <button wx:for="{{materials}}" wx:key="id" class="secondary" data-id="{{item.id}}" bindtap="viewMaterial" disabled="{{previewing || preparing || writing || pendingRetry}}">{{item.label}}</button><text wx:if="{{!materials.length}}" class="muted">本申请无上传材料</text>
    <view wx:if="{{materialPath}}"><text class="muted">{{materialLabel}}</text><image class="material-image" src="{{materialPath}}" mode="widthFix" show-menu-by-longpress="{{false}}" binderror="onMaterialError"/><button class="text-button" bindtap="clearFiles">关闭材料</button></view>
  </view>
  <view wx:if="{{ready && (canApprove || canReject || canRevoke || canCancel || canToggle)}}" class="admin-card">
    <text class="section-title">{{resource === 'plans' ? '套餐启停' : '处理申请'}}</text>
    <block wx:if="{{resource !== 'plans'}}"><text class="form-label">{{resource === 'salons' ? '审核备注 / 取消原因（内部）' : '内部审核备注'}}</text><textarea value="{{remark}}" maxlength="1000" data-field="remark" bindinput="onFieldInput" placeholder="请填写审核依据或处理原因" disabled="{{preparing || writing || pendingRetry}}"/></block>
    <block wx:if="{{resource === 'certifications'}}"><text class="form-label">申请人可见反馈（拒绝、撤销时必填）</text><textarea value="{{feedback}}" maxlength="500" data-field="feedback" bindinput="onFieldInput" placeholder="仅填写可向申请人展示的说明" disabled="{{preparing || writing || pendingRetry}}"/>
      <block wx:if="{{canApprove}}"><text class="form-label">核验来源</text><picker range="{{sources}}" range-key="label" value="{{sourceIndex}}" data-field="sourceIndex" bindchange="onChoice" disabled="{{preparing || writing || pendingRetry}}"><view class="picker">{{sources[sourceIndex].label}}<text>⌄</text></view></picker><text class="form-label">内部凭据引用（审核通过时必填）</text><input class="form-input" value="{{evidenceReference}}" maxlength="1000" data-field="evidenceReference" bindinput="onFieldInput" placeholder="填写已核查的凭据或记录引用" disabled="{{preparing || writing || pendingRetry}}"/>
        <picker wx:if="{{kind === 'education'}}" range="{{educationOptions}}" value="{{educationIndex}}" data-field="educationIndex" bindchange="onChoice" disabled="{{preparing || writing || pendingRetry}}"><view class="picker">{{educationOptions[educationIndex]}}<text>⌄</text></view></picker>
        <picker wx:if="{{kind === 'assets'}}" range="{{assetOptions}}" range-key="label" value="{{assetIndex}}" data-field="assetIndex" bindchange="onChoice" disabled="{{preparing || writing || pendingRetry}}"><view class="picker">{{assetOptions[assetIndex].label}}<text>⌄</text></view></picker>
      </block>
    </block>
    <text wx:if="{{resource === 'plans'}}" class="muted">仅支持启用和停用；不修改价格，不影响已有订单和权益。</text>
    <view class="actions"><button wx:if="{{canApprove}}" class="primary" data-command="approve" bindtap="prepareWrite" disabled="{{preparing || writing || pendingRetry}}">审核通过</button><button wx:if="{{canReject}}" class="secondary" data-command="reject" bindtap="prepareWrite" disabled="{{preparing || writing || pendingRetry}}">拒绝申请</button><button wx:if="{{canRevoke}}" class="secondary" data-command="revoke" bindtap="prepareWrite" disabled="{{preparing || writing || pendingRetry}}">撤销认证</button><button wx:if="{{canCancel}}" class="secondary" data-command="cancel" bindtap="prepareWrite" disabled="{{preparing || writing || pendingRetry}}">取消沙龙</button><button wx:if="{{canToggle}}" class="primary" data-command="toggle" bindtap="prepareWrite" disabled="{{preparing || writing || pendingRetry}}">{{active ? '停用套餐' : '启用套餐'}}</button></view>
    <text wx:if="{{preparing}}" class="muted">正在核对最新版本，请稍候…</text><text wx:if="{{writing}}" class="muted">正在提交，请勿重复点击…</text>
  </view>
  <view wx:if="{{ready && resource === 'orders'}}" class="admin-card muted">订单仅供查询，退款和权益变更不在此页面执行。</view>
  <button class="secondary" bindtap="loadDetail" disabled="{{loading || preparing || writing}}">刷新核对状态</button><button class="text-button" bindtap="goBack">返回列表</button>
</view>
