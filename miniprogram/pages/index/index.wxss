.login-page {
  padding-top: 72rpx;
  background:
    radial-gradient(circle at 88% 4%, rgba(168, 121, 72, 0.13), transparent 34%),
    #f7f3ec;
}

.entry-brand {
  box-sizing: border-box;
  min-height: 360rpx;
  padding: 42rpx 18rpx 32rpx;
}

.entry-kicker,
.entry-title,
.entry-subtitle,
.entry-privacy,
.assurance-title,
.assurance-note {
  display: block;
}

.entry-kicker {
  color: #a35d45;
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.entry-title {
  max-width: 590rpx;
  margin-top: 24rpx;
  color: #2f2924;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.16;
}

.entry-subtitle {
  max-width: 570rpx;
  margin-top: 24rpx;
  color: #73675f;
  font-size: 27rpx;
  line-height: 1.7;
}

.login-panel {
  box-sizing: border-box;
  padding: 30rpx;
  border: 1rpx solid rgba(151, 119, 82, 0.16);
  border-radius: 18rpx;
  background: #fffdf9;
}

.entry-action {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin: 28rpx 0 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 14rpx;
  background: #a35d45;
  color: #fffefb;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.entry-action::after {
  border: 0;
}

.entry-action[disabled] {
  opacity: 0.58;
}

.entry-privacy {
  margin-top: 18rpx;
  color: #8a7e75;
  font-size: 21rpx;
  line-height: 1.55;
}

.entry-assurances {
  margin-top: 34rpx;
  padding: 0 10rpx;
}

.assurance-row {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(151, 119, 82, 0.12);
}

.assurance-row:last-child {
  border-bottom: 0;
}

.assurance-index {
  flex: 0 0 48rpx;
  color: #a87948;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.45;
}

.assurance-copy {
  flex: 1;
  min-width: 0;
}

.assurance-title {
  color: #2f2924;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
}

.assurance-note {
  margin-top: 7rpx;
  color: #7a6e66;
  font-size: 23rpx;
  line-height: 1.55;
}
