<view class="page login-page safe-bottom">
  <view class="entry-brand">
    <text class="entry-kicker">HL 婚恋服务</text>
    <text class="entry-title">{{registrationMode ? '准备参加这次活动' : '认真认识一个人'}}</text>
    <text class="entry-subtitle">{{registrationMode ? '先补齐手机号、称呼和本人照片，保存后回到活动页确认报名。' : loginIntent ? '登录后继续刚才的操作，也可以先浏览活动与服务介绍。' : '先浏览近期活动与服务介绍，报名、互动或购买时再自主登录。'}}</text>
  </view>

  <view wx:if="{{!registrationMode && !loginIntent}}" class="public-browse">
    <view class="public-heading">
      <text class="section-title">近期活动</text>
      <text class="public-link" bindtap="browseActivities">全部活动 →</text>
    </view>
    <text class="section-note">无需登录，先看看适合自己的线下相遇。</text>
    <text wx:if="{{publicLoading && !publicSalons.length}}" class="public-status">正在读取活动…</text>
    <view wx:for="{{publicSalons}}" wx:key="id" class="public-event" data-id="{{item.id}}" bindtap="openPublicSalon">
      <view class="public-event-top"><text class="public-event-title">{{item.title}}</text><text class="public-event-price">{{item.priceText}}</text></view>
      <text class="public-event-meta">{{item.dateText}} · {{item.location || '地点待定'}}</text>
      <text class="public-event-description">{{item.description || '查看活动详情，了解活动内容与安排。'}}</text>
      <text class="public-link">查看详情 →</text>
    </view>
    <text wx:if="{{!publicLoading && !publicSalons.length}}" class="public-status">暂无近期活动，可查看往期活动或先了解下方服务。</text>
    <button class="entry-action" bindtap="browseActivities">浏览全部活动</button>

    <view class="public-services">
      <text class="section-title">了解我们的服务</text>
      <view class="public-service-row"><text class="assurance-title">会员浏览与互动</text><text class="assurance-note">登录后可完善自己的资料，查看推荐、表达喜欢并管理双方互动。公开资料与联系方式分开处理。</text></view>
      <view class="public-service-row"><text class="assurance-title">人工牵线服务</text><text class="assurance-note">由负责主理人了解需求并安排牵线，双方确认后再建立联系。服务次数与有效期以所选方案为准。</text></view>
      <view class="public-service-row"><text class="assurance-title">主理人工作台</text><text class="assurance-note">面向开展会员服务与活动组织的主理人，提供会员维护、资源协作和沙龙发布等功能。</text></view>
    </view>
    <view wx:if="{{publicPlans.length}}" class="public-services">
      <text class="section-title">当前服务方案</text>
      <view wx:for="{{publicPlans}}" wx:key="planCode" class="public-plan">
        <view><text class="assurance-title">{{item.name}}</text><text class="assurance-note">{{item.termsText}}</text></view>
        <text class="public-plan-price">{{item.priceText}}</text>
      </view>
      <text class="entry-privacy">VIP与人工牵线为独立产品，查看方案无需付款。</text>
    </view>
    <text wx:if="{{publicError}}" class="registration-error">{{publicError}}</text>
    <button wx:if="{{publicError}}" class="registration-retry" bindtap="retryPublicContent">重新读取活动与方案</button>
    <view class="public-login-choice">
      <text class="section-title">准备好再登录</text>
      <text class="section-note">浏览活动和服务介绍无需登录。需要报名、互动或购买服务时，再选择登录。</text>
      <button class="registration-retry" loading="{{loading}}" disabled="{{loading}}" bindtap="login">微信登录</button>
      <text wx:if="{{errorText}}" class="registration-error">{{errorText}}</text>
    </view>
  </view>

  <view wx:if="{{registrationMode && loggedIn}}" class="login-panel registration-panel">
    <text class="section-title">活动报名资料</text>
    <text wx:if="{{checking}}" class="section-note">正在确认已有资料，请稍候。</text>
    <view wx:else>
      <view class="registration-photo-row">
        <image wx:if="{{photoDisplayUrl}}" class="registration-photo" src="{{photoDisplayUrl}}" mode="aspectFill"></image>
        <view wx:else class="registration-photo registration-photo-empty">本人照片</view>
        <view class="registration-photo-copy">
          <text class="registration-label">一张本人照片</text>
          <text class="registration-note">用于活动中认识彼此。</text>
          <button class="registration-photo-button" bindtap="chooseRegistrationPhoto" loading="{{photoUploading}}" disabled="{{saving || photoUploading || !eventId}}">{{photoDisplayUrl ? '更换照片' : '上传照片'}}</button>
        </view>
      </view>
      <view class="registration-field">
        <text class="registration-label">称呼</text>
        <input class="registration-input" value="{{nickname}}" placeholder="活动中怎么称呼你" maxlength="40" disabled="{{saving}}" bindinput="onRegistrationName" />
      </view>
      <view class="registration-field">
        <text class="registration-label">手机号</text>
        <input class="registration-input" value="{{phone}}" type="number" placeholder="用于活动联系" maxlength="11" disabled="{{saving}}" bindinput="onRegistrationPhone" />
        <text class="registration-note">{{phoneStatus === 'verified' ? '该号码已通过微信授权获取。' : '手动填写的号码尚未验证，请核对无误。'}}</text>
      </view>
      <button class="entry-action" loading="{{saving}}" disabled="{{saving || photoUploading || !eventId}}" bindtap="saveRegistration">保存并返回活动</button>
      <text class="entry-privacy">保存资料后，还需要在活动页确认报名。</text>
    </view>
    <text wx:if="{{errorText}}" class="registration-error">{{errorText}}</text>
    <button wx:if="{{errorText && !checking}}" class="registration-retry" disabled="{{saving || photoUploading}}" bindtap="retryRegistration">重新读取已有资料</button>
  </view>

  <view wx:elif="{{registrationMode || loginIntent}}" class="login-panel">
    <text class="section-title">开始使用</text>
    <text class="section-note">微信快捷登录，不需要另外注册账号。</text>
    <button class="entry-action" loading="{{loading}}" disabled="{{loading || (registrationMode && !eventId)}}" bindtap="login">{{registrationMode ? '微信登录并补齐资料' : '微信登录并继续'}}</button>
    <button class="registration-retry" bindtap="browseActivities">继续浏览活动</button>
    <text wx:if="{{errorText}}" class="registration-error">{{errorText}}</text>
    <text class="entry-privacy">联系方式、验资材料和主理人服务记录不会对其他会员公开。</text>
  </view>

  <view wx:if="{{!registrationMode && !loginIntent}}" class="entry-assurances">
    <view class="assurance-row">
      <text class="assurance-index">01</text>
      <view class="assurance-copy">
        <text class="assurance-title">资料分层展示</text>
        <text class="assurance-note">公开资料用于认识彼此，内部资料仅用于主理人服务。</text>
      </view>
    </view>
    <view class="assurance-row">
      <text class="assurance-index">02</text>
      <view class="assurance-copy">
        <text class="assurance-title">按自己的节奏了解</text>
        <text class="assurance-note">先看推荐和活动，需要时再联系主理人或开通服务。</text>
      </view>
    </view>
  </view>
</view>
