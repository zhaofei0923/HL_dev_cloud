<view class="page safe-bottom">
  <view class="card hero invite-hero">
    <text class="eyebrow">{{activityInvite ? '活动邀请' : '主理人邀请'}}</text>
    <text class="title">{{activityInvite ? '查看沙龙邀请' : '确认添加主理人'}}</text>
    <text class="subtitle">{{activityInvite ? '先查看活动详情，决定参加时再登录并确认报名。参加活动不会变更你的主理人归属。' : '先了解邀请，自愿确认加入后即可成为该主理人名下免费会员，无需管理员审核。'}}</text>
    <view class="summary-strip">
      <view class="summary-item">
        <text class="summary-value">{{code || '待识别'}}</text>
        <text class="summary-label">邀请码</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{sourceText}}</text>
        <text class="summary-label">添加方式</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{activityInvite ? '活动页' : '确认加入'}}</text>
        <text class="summary-label">{{activityInvite ? '确认报名' : '归属确认'}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="card notice-card">
    <text class="section-title">邀请不可用</text>
    <text class="section-note">{{errorText}}</text>
    <button wx:if="{{activityInvite}}" class="btn gold invite-action" bindtap="loadInvite" loading="{{loading}}" disabled="{{loading}}">查看活动详情</button>
    <button wx:if="{{activityInvite}}" class="btn secondary invite-action" bindtap="goSalonDetail">查看活动详情</button>
    <block wx:else>
      <button class="btn gold invite-action" bindtap="loadInvite" loading="{{loading}}" disabled="{{loading}}">重新确认邀请</button>
      <button class="btn ghost invite-action" bindtap="goBrowseActivities">先浏览活动</button>
    </block>
  </view>

  <view wx:elif="{{!loggedIn && !activityInvite && code}}" class="card invite-card">
    <text class="section-title">邀请你加入免费会员</text>
    <text class="section-note">浏览活动无需登录。若选择接受本次邀请，请主动登录并确认加入；此操作不购买VIP或人工牵线套餐。</text>
    <button class="btn gold invite-action" bindtap="confirmInvite" loading="{{loginLoading}}" disabled="{{loginLoading}}">微信登录并确认加入</button>
    <button class="btn ghost invite-action" bindtap="goBrowseActivities">先浏览活动</button>
  </view>

  <view wx:elif="{{invite}}" class="card invite-card">
    <view class="invite-profile">
      <image class="invite-avatar" src="{{invite.avatarUrl || '/assets/members/avatar-female-1.png'}}" mode="aspectFill"></image>
      <view class="invite-copy">
        <text class="section-title">{{invite.nickname || '主理人'}}</text>
        <text class="section-note">主理人编号 {{invite.matchmakerNo}}</text>
      </view>
      <text class="tag gold">已认证</text>
    </view>

    <view class="invite-info-grid">
      <view class="metric">
        <text class="metric-label">会员服务</text>
        <text class="metric-value">{{invite.memberCount || 0}}</text>
        <text class="metric-hint">名下会员</text>
      </view>
      <view class="metric">
        <text class="metric-label">服务等级</text>
        <text class="metric-value">L{{invite.level || 1}}</text>
        <text class="metric-hint">主理人等级</text>
      </view>
    </view>

    <view wx:if="{{invite.alreadyAssigned && !autoDone}}" class="notice-inline">
      <text class="item-meta">{{autoMode ? '当前账号已有关联主理人，确认后将核对是否为同一主理人。' : '你已有关联主理人，暂不能添加其他主理人。'}}</text>
    </view>
    <view wx:elif="{{!autoMode && invite.existingRequest && invite.existingRequest.status === 'pending'}}" class="notice-inline">
      <text class="item-meta">你之前的邀请尚未完成，请点击“确认加入”直接完成。</text>
    </view>
    <view wx:if="{{autoMessage}}" class="notice-inline {{autoDone ? 'success' : 'warning'}}">
      <text class="item-meta">{{autoMessage}}</text>
    </view>

    <button class="btn gold invite-action" loading="{{submitting || loginLoading}}" disabled="{{submitting || loginLoading || autoDone || !canSubmit}}" bindtap="confirmInvite">{{actionText}}</button>
    <button wx:if="{{autoMode && eventId}}" class="btn secondary invite-action" bindtap="goSalonDetail">查看沙龙详情</button>
    <button class="btn ghost invite-action" bindtap="copyCode">复制邀请码</button>
  </view>

  <view wx:else class="card invite-card">
    <text class="section-title">{{activityInvite ? '正在打开活动' : '正在确认邀请'}}</text>
    <text class="section-note">{{loading ? (activityInvite ? '稍后可浏览活动详情。' : '正在读取主理人信息，请稍候。') : '请确认邀请链接后重试。'}}</text>
  </view>
</view>
