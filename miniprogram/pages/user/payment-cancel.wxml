<view class="page safe-bottom payment-cancel-page">
  <view class="payment-cancel-intro">
    <text class="title">{{order.status === 'paid' ? '原订单已支付' : order.status === 'refunded' ? '原订单已退款' : order.isCancelled ? '订单已取消' : '已退出本次支付'}}</text>
  </view>
  <view class="card payment-cancel-order">
    <text class="section-title">原订单状态</text>
    <text wx:if="{{loading}}" class="item-desc">正在读取订单…</text>
    <text wx:if="{{cancelling && !order}}" class="item-desc">正在处理取消请求…</text>
    <block wx:if="{{order}}">
      <view class="payment-cancel-summary"><text>{{order.planTitle}}</text><text>{{order.amountText}}</text></view>
      <text class="payment-cancel-status">{{order.statusText}}</text>
      <text wx:if="{{order.status !== 'closed'}}" class="item-desc">{{order.resultText}}</text>
      <text class="payment-cancel-number">订单号 {{order.outTradeNo}}</text>
    </block>
    <text wx:if="{{!order && !loading && !cancelling}}" class="item-desc">{{errorText}}</text>
    <text wx:if="{{order && errorText}}" class="payment-cancel-hint" aria-role="alert">{{errorText}}</text>
    <text wx:if="{{!order || order.status === 'pending'}}" class="payment-cancel-hint">付款未确认，请勿重复付款。</text>
    <button class="btn ghost" bindtap="refresh" loading="{{loading}}" disabled="{{loading || cancelling}}">刷新订单状态</button>
    <button wx:if="{{order.canCancel}}" class="btn ghost payment-order-cancel" bindtap="cancelOrder" loading="{{cancelling}}" disabled="{{loading || cancelling}}">取消订单</button>
  </view>
  <view class="payment-cancel-actions">
    <button class="btn gold" bindtap="openOrder">查看原订单</button>
    <button class="btn ghost" bindtap="returnToMembership">返回会员页</button>
    <button class="payment-cancel-browse" bindtap="continueBrowsing">继续浏览资料</button>
  </view>
</view>
