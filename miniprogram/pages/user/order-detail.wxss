@import "./orders.wxss";
.order-detail-hero { padding: 26rpx 26rpx 30rpx; border: 1rpx solid #e7ded4; border-radius: 14rpx; background: #fffdf9; }
.order-detail-hero .order-status { margin-top: 0; }
.order-detail-amount { display: block; margin: 22rpx 0 13rpx; font-size: 58rpx; font-weight: 800; line-height: 1.3; }
.order-result-panel { margin-top: 20rpx; padding: 23rpx 26rpx; border-left: 5rpx solid #a35d45; border-radius: 0 12rpx 12rpx 0; background: #eee5db; }
.order-section-title { display: block; color: #674f3f; font-size: 23rpx; font-weight: 700; }
.order-result-copy { display: block; margin-top: 8rpx; color: #5e4c3e; font-size: 26rpx; line-height: 1.75; }
.order-facts { margin: 24rpx 0; padding: 0 24rpx; border: 1rpx solid #e7ded4; border-radius: 14rpx; background: #fffdf9; }
.order-fact { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid #eee7de; font-size: 25rpx; line-height: 1.6; }
.order-fact:last-child { border-bottom: 0; }
.order-fact-label { flex-shrink: 0; width: 120rpx; color: #8c7c70; }
.order-fact-value { min-width: 0; text-align: right; overflow-wrap: anywhere; }
.order-number-copy { min-width: 0; flex: 1; text-align: right; }
.order-number { display: block; font-size: 23rpx; overflow-wrap: anywhere; word-break: break-all; }
.order-number-copy .order-text-button { margin-left: auto; font-size: 23rpx; }
.order-detail-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.order-primary, .order-secondary { flex: 1; margin: 0; padding: 23rpx 12rpx; border-radius: 12rpx; font-size: 26rpx; font-weight: 700; line-height: 1.5; }
.order-primary { background: #a35d45; color: #fffdf9; }
.order-secondary { border: 1rpx solid #d9c9bb; background: #fffdf9; color: #86634f; }
.order-cancel-action { width: 100%; margin-top: 16rpx; }
