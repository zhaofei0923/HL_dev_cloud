<view class="page safe-bottom with-bottom-nav salon-page">
  <view class="salon-heading">
    <text class="salon-title">活动</text>
    <text class="salon-note">选择合适的时间与地点，线下轻松认识彼此。</text>
  </view>

  <view class="segment">
    <button class="btn {{active === 'all' ? 'active' : ''}}" disabled="{{loading}}" bindtap="loadAll">全部活动</button>
    <button class="btn {{active === 'mine' ? 'active' : ''}}" disabled="{{loading}}" bindtap="loadMine">我的报名</button>
  </view>

  <view class="salon-list-shell">
    <view class="row list-header">
      <view>
        <text class="section-title">{{listTitle}}</text>
        <text class="section-note">{{listNote}}</text>
      </view>
      <text class="salon-count">{{loading ? '加载中' : list.length + ' 场'}}</text>
    </view>

    <block wx:if="{{list.length}}">
      <view wx:for="{{list}}" wx:key="id" class="salon-card" data-id="{{item.id}}" bindtap="openDetail">
        <view class="row salon-card-head">
          <view class="salon-card-copy">
            <text class="item-title">{{item.title}}</text>
            <text class="salon-date">{{item.eventDate}}</text>
          </view>
          <text class="tag gold">{{item.statusText}}</text>
        </view>
        <text class="salon-location">{{item.location}}</text>
        <view class="salon-card-footer">
          <text class="salon-seat">{{item.seatText}}</text>
          <text class="salon-price">{{item.priceText}}</text>
        </view>
      </view>
    </block>

    <view wx:else class="empty">
      <text class="empty-title">{{loading ? '正在加载活动' : '暂无开放活动'}}</text>
      <text class="empty-note">{{loading ? '请稍候，正在整理近期活动安排。' : '新的线下沙龙开放后会第一时间在这里展示。'}}</text>
    </view>
  </view>

</view>
