<view class="page safe-bottom with-bottom-nav profile-page {{editingProfile ? 'editing-mode' : ''}}">
  <view wx:if="{{guest}}" class="card guest-entry-card">
    <text class="title">我的资料</text>
    <button class="btn" bindtap="goGuestLogin">登录后使用</button>
    <button class="btn ghost" bindtap="browseActivities">浏览活动</button>
  </view>
  <block wx:else>
  <block wx:if="{{!editingProfile}}">
  <view class="profile-summary">
    <image class="profile-summary-avatar" src="{{preview.avatarUrl}}" mode="aspectFill"></image>
    <view class="profile-summary-copy">
      <view class="profile-name-row"><text class="profile-name">{{preview.displayName || '我的资料'}}</text><text wx:if="{{isVipBadge}}" class="profile-vip-badge" aria-label="有效VIP会员">VIP</text></view>
      <text wx:if="{{preview.metaText}}" class="profile-meta">{{preview.metaText}}</text>
    </view>
    <text class="profile-visibility {{form.displayEnabled ? 'open' : ''}}">{{form.relationshipStatus === 'coupled' ? '已脱单·隐藏' : form.displayEnabled ? '展示中' : '仅自己'}}</text>
  </view>

  <view class="profile-completion">
    <view class="completion-copy">
      <text class="completion-value">{{completionText}}</text>
      <view class="completion-detail">
        <text class="section-title">资料完成度</text>
      </view>
    </view>
    <button class="profile-primary-action" disabled="{{!profileReady}}" loading="{{loading}}" bindtap="toggleProfileEditor">{{loading ? '读取资料中' : formDirty ? '继续编辑' : '编辑资料'}}</button>
  </view>

  <view wx:if="{{!profileReady && profileError}}" class="certification-load-error">
    <text>{{profileError}}</text>
    <button class="certification-retry" bindtap="retryProfile" disabled="{{loading}}">重试</button>
  </view>

  <text wx:if="{{formDirty}}" class="profile-save-feedback dirty">资料修改尚未保存</text>

  <view class="certification-center">
    <view class="certification-center-heading" bindtap="toggleCertifications" aria-role="button" aria-label="{{certificationsExpanded ? '收起认证中心' : '展开认证中心'}}">
      <view class="profile-menu-copy">
        <text class="section-title">认证中心</text>
        <text class="section-note">{{certificationsLoading ? '读取认证状态中' : certificationsError ? '认证状态暂未读取' : certificationSummary}}</text>
      </view>
      <text class="profile-menu-state">{{certificationsExpanded ? '收起' : '查看全部'}}</text>
    </view>
    <view wx:if="{{certificationsError}}" class="certification-load-error">
      <text>{{certificationsError}}</text>
      <button class="certification-retry" bindtap="retryCertifications" disabled="{{certificationsLoading}}">重试</button>
    </view>
    <view wx:if="{{!certificationsExpanded}}" class="certification-quick-links">
      <button class="certification-quick-link" data-kind="education" bindtap="openCertification">学历认证</button>
      <button class="certification-quick-link" data-kind="assets" bindtap="openCertification">资产认证</button>
    </view>
    <block wx:if="{{certificationsExpanded}}">
    <view wx:for="{{certificationRows}}" wx:key="kind" class="profile-menu-row certification-row" data-kind="{{item.kind}}" bindtap="openCertification" aria-role="button" aria-label="{{item.title}}，{{certificationsError ? '状态未读取' : item.state}}">
      <view class="profile-menu-copy">
        <text class="profile-menu-title">{{item.title}}</text>
      </view>
      <text class="certification-state {{item.verified && !certificationsError ? 'verified' : ''}}">{{certificationsLoading ? '读取中' : certificationsError ? '状态未读取' : item.state}}</text>
      <view class="profile-menu-chevron"></view>
    </view>
    </block>
  </view>

  <view class="profile-menu">
    <view wx:if="{{adminEntryVisible}}" class="profile-menu-row" bindtap="goAdminBackend" aria-role="button" aria-label="进入管理后台">
      <view class="profile-menu-copy">
        <text class="profile-menu-title">管理后台</text>
        <text wx:if="{{!adminEntryReady}}" class="profile-menu-note">后台尚未开放</text>
      </view>
      <text class="profile-menu-state">{{adminEntryOpening ? '确认中' : '进入'}}</text>
      <view class="profile-menu-chevron"></view>
    </view>
    <view class="profile-menu-row" bindtap="goMembership" aria-role="button" aria-label="查看我的特权">
      <view class="profile-menu-copy">
        <text class="profile-menu-title">我的特权</text>
      </view>
      <view class="profile-menu-chevron"></view>
    </view>
    <view class="profile-menu-row" bindtap="goPreferences" aria-role="button" aria-label="设置我心仪的Ta">
      <view class="profile-menu-copy"><text class="profile-menu-title">我心仪的Ta</text></view>
      <view class="profile-menu-chevron"></view>
    </view>
    <view class="profile-menu-row" bindtap="goRelationshipStatus" aria-role="button" aria-label="成功脱单与匹配管理">
      <view class="profile-menu-copy"><text class="profile-menu-title">{{form.relationshipStatus === 'coupled' ? '已脱单' : '成功脱单 · 邀请脱单'}}</text></view>
      <view class="profile-menu-chevron"></view>
    </view>
    <view class="profile-menu-row" bindtap="goOrders" aria-role="button" aria-label="查看我的订单">
      <view class="profile-menu-copy">
        <text class="profile-menu-title">我的订单</text>
      </view>
      <view class="profile-menu-chevron"></view>
    </view>
    <view class="profile-menu-row" bindtap="toggleMatchmakerPanel" aria-role="button" aria-label="查看我的主理人">
      <view class="profile-menu-copy">
        <text class="profile-menu-title">我的主理人</text>
      </view>
      <text class="profile-menu-state">{{matchmakerPanelOpen ? '收起' : '查看'}}</text>
    </view>
    <view class="profile-menu-row" bindtap="togglePreview" aria-role="button" aria-label="查看档案预览">
      <view class="profile-menu-copy">
        <text class="profile-menu-title">档案预览</text>
      </view>
      <text class="profile-menu-state">{{previewOpen ? '收起' : '查看'}}</text>
    </view>
    <view class="profile-menu-row" bindtap="toggleAccountPanel" aria-role="button" aria-label="查看公开与账号设置">
      <view class="profile-menu-copy">
        <text class="profile-menu-title">公开与账号设置</text>
      </view>
      <text class="profile-menu-state">{{accountPanelOpen ? '收起' : '查看'}}</text>
    </view>
  </view>

  <block wx:if="{{matchmakerPanelOpen}}">
    <view class="card switch-card profile-subpanel">
      <text class="section-title">{{matchmakerEntryTitle}}</text>
      <text wx:if="{{!matchmakerApproved}}" class="section-note">{{matchmakerEntryNote}}</text>
      <button class="btn {{matchmakerApproved ? 'gold' : 'secondary'}} panel-action" bindtap="goMatchmaker">{{matchmakerEntryButton}}</button>
    </view>

    <view class="card privacy-card profile-subpanel">
      <text class="section-title">添加主理人</text>
      <view class="matchmaker-option-grid">
        <view class="matchmaker-option" bindtap="scanMatchmakerInvite">
          <text class="option-title">扫码添加</text>
        </view>
        <view class="matchmaker-option active">
          <text class="option-title">邀请码</text>
        </view>
      </view>
      <view class="matchmaker-request-row">
        <input class="request-input" value="{{matchmakerCode}}" bindinput="onMatchmakerCodeInput" placeholder="主理人编号 / 邀请码" />
        <button class="btn gold request-btn" loading="{{matchmakerRequesting}}" disabled="{{matchmakerRequesting}}" bindtap="submitMatchmakerRequest">下一步</button>
      </view>
    </view>

    <view wx:if="{{referralCard.canShare}}" class="card referral-card profile-subpanel">
      <view class="referral-head">
        <view class="referral-copy">
          <text class="section-title">邀请好友注册</text>
        </view>
        <text class="tag gold">同一主理人</text>
      </view>
      <view class="referral-matchmaker">
        <image class="referral-avatar" src="{{referralCard.matchmaker.avatarUrl || '/assets/members/avatar-female-1.png'}}" mode="aspectFill"></image>
        <view class="referral-copy">
          <text class="item-title">{{referralCard.matchmaker.nickname || '主理人'}}</text>
          <text class="item-meta">主理人编号 {{referralCard.matchmaker.matchmakerNo}}</text>
        </view>
      </view>
      <view class="button-row referral-actions">
        <button class="btn secondary" bindtap="showInviteLinkTip">链接说明</button>
        <button class="btn gold" open-type="share">分享注册链接</button>
      </view>
    </view>
  </block>

  <view wx:if="{{accountPanelOpen}}" class="card profile-subpanel account-panel">
    <text class="section-note preference-save-note">设置即时保存</text>
    <text class="profile-save-feedback {{saveState}}" aria-live="polite">{{saveStatus}}</text>
    <view class="privacy-row">
      <view class="privacy-copy">
        <text class="section-title">资料展示</text>
        <text class="section-note">开启后公开资料，联系方式不公开。</text>
      </view>
      <switch checked="{{form.displayEnabled}}" color="#a45d43" disabled="{{!profileReady || loading || saving || form.relationshipStatus === 'coupled'}}" bindchange="onDisplayEnabledChange"></switch>
    </view>
    <view class="divider"></view>
    <view class="privacy-row">
      <view class="privacy-copy">
        <text class="section-title">参与资产分类</text>
        <text class="section-note">核验金融资产达200万元，可进入资产分类。</text>
      </view>
      <switch checked="{{form.assetCategoryConsent}}" color="#a45d43" data-field="assetCategoryConsent" disabled="{{!profileReady || loading || saving}}" bindchange="onAssetPreferenceChange"></switch>
    </view>
    <view class="divider"></view>
    <view class="privacy-row">
      <view class="privacy-copy">
        <text class="section-title">公开已核验资产区间</text>
        <text class="section-note">开启展示区间，关闭仅显示“资产已认证”。</text>
      </view>
      <switch checked="{{form.assetRangeDisclosure}}" color="#a45d43" data-field="assetRangeDisclosure" disabled="{{!profileReady || loading || saving}}" bindchange="onAssetPreferenceChange"></switch>
    </view>
    <view class="divider"></view>
    <button class="btn ghost logout-action" bindtap="logout">退出登录</button>
  </view>
  </block>

  <view wx:if="{{editingProfile && profileReady}}" class="card form-card profile-subpanel">
    <view class="profile-panel-heading">
      <view>
        <text class="section-title">编辑资料</text>
        <text class="section-note">照片即时保存，其他修改需保存。</text>
      </view>
      <button class="panel-close" disabled="{{saving || uploadingPhotos}}" bindtap="toggleProfileEditor">返回我的</button>
    </view>

    <view class="form-section">
      <text class="section-title">基础信息</text>
      <view class="field">
        <text class="field-label">姓名</text>
        <input class="field-input" value="{{form.realName}}" data-field="realName" bindinput="onInput" placeholder="请输入真实姓名或常用称呼" />
      </view>
      <view class="field-row">
        <view class="field half">
          <text class="field-label">性别</text>
          <picker mode="selector" range="{{genderOptions}}" bindchange="onGenderChange">
            <view class="field-input picker-value {{form.gender ? '' : 'placeholder'}}">{{form.gender === '1' ? '男' : form.gender === '2' ? '女' : '请选择'}}</view>
          </picker>
        </view>
        <view class="field half">
          <text class="field-label">年龄</text>
          <picker mode="selector" range="{{ageOptions}}" bindchange="onAgeChange">
            <view class="field-input picker-value">{{ageText}}</view>
          </picker>
        </view>
      </view>
      <view class="field-row">
        <view class="field half">
          <text class="field-label">身高</text>
          <picker mode="selector" range="{{heightOptions}}" bindchange="onHeightChange">
            <view class="field-input picker-value">{{heightText}}</view>
          </picker>
        </view>
        <view class="field half">
          <text class="field-label">籍贯</text>
          <picker mode="region" bindchange="onNativePlaceChange">
            <view class="field-input picker-value">{{nativePlaceText}}</view>
          </picker>
        </view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="form-section">
      <text class="section-title">形象资料</text>
      <text class="section-note">首张照片作为头像和封面。</text>
      <view wx:if="{{photoCount}}" class="photo-grid">
        <view wx:for="{{form.photoDisplayUrls}}" wx:key="*this" class="photo-tile">
          <image class="photo-thumb" src="{{item}}" mode="aspectFill"></image>
          <view class="photo-delete" data-index="{{index}}" catchtap="deletePhoto" aria-role="button" aria-disabled="{{saving || uploadingPhotos}}" aria-label="删除第{{index + 1}}张照片">
            <view class="photo-delete-disc"></view>
            <view class="photo-delete-line photo-delete-line-a"></view>
            <view class="photo-delete-line photo-delete-line-b"></view>
          </view>
        </view>
      </view>
      <view wx:else class="photo-empty">未上传照片 · 当前为系统示意图</view>
      <button class="btn ghost upload-wall-btn" loading="{{uploadingPhotos}}" disabled="{{!profileReady || saving || uploadingPhotos}}" bindtap="choosePhotos">{{uploadingPhotos ? '正在处理照片' : '上传照片并保存'}}</button>
    </view>

    <view class="divider"></view>

    <view class="form-section">
      <text class="section-title">城市与职业</text>
      <view class="field">
        <text class="field-label">城市</text>
        <picker mode="region" bindchange="onCityChange">
          <view class="field-input picker-value">{{cityText}}</view>
        </picker>
      </view>
      <view class="field-row">
        <view class="field half">
          <text class="field-label">学历</text>
          <picker mode="selector" range="{{educationOptions}}" bindchange="onEducationChange">
            <view class="field-input picker-value">{{educationText}}</view>
          </picker>
        </view>
        <view class="field half">
          <text class="field-label">收入</text>
          <picker mode="selector" range="{{incomeOptions}}" bindchange="onIncomeChange">
            <view class="field-input picker-value">{{incomeText}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <text class="field-label">职业</text>
        <picker mode="selector" range="{{occupationOptions}}" bindchange="onOccupationChange">
          <view class="field-input picker-value">{{occupationText}}</view>
        </picker>
      </view>
    </view>

    <view class="divider"></view>

    <view class="form-section">
      <text class="section-title">生活状态</text>
      <text class="section-note">婚况、房产、车辆用于公开资料。</text>
      <view class="field-row">
        <view class="field half">
          <text class="field-label">婚况</text>
          <picker mode="selector" range="{{maritalOptions}}" bindchange="onMaritalChange">
            <view class="field-input picker-value {{form.maritalStatus ? '' : 'placeholder'}}">{{form.maritalStatus || '请选择'}}</view>
          </picker>
        </view>
        <view class="field half">
          <text class="field-label">房产</text>
          <picker mode="selector" range="{{houseOptions}}" bindchange="onHouseChange">
            <view class="field-input picker-value {{form.houseStatus ? '' : 'placeholder'}}">{{form.houseStatus || '请选择'}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <text class="field-label">车辆</text>
        <picker mode="selector" range="{{carOptions}}" bindchange="onCarChange">
          <view class="field-input picker-value {{form.carStatus ? '' : 'placeholder'}}">{{form.carStatus || '请选择'}}</view>
        </picker>
      </view>
    </view>

    <view class="divider"></view>

    <view class="form-section">
      <text class="section-title">介绍与期待</text>
      <view class="field">
        <text class="field-label">自我介绍</text>
        <textarea class="field-input" value="{{form.selfIntro}}" data-field="selfIntro" bindinput="onInput" placeholder="写几句让主理人快速了解你的信息" />
      </view>
      <view class="field">
        <text class="field-label">择偶期待</text>
        <textarea class="field-input" value="{{form.partnerRequirement}}" data-field="partnerRequirement" bindinput="onInput" placeholder="说明年龄、城市、价值观或生活方式期待" />
      </view>
    </view>

    <view class="profile-save-bar">
      <text class="profile-save-feedback {{saveState}}" aria-live="polite">{{saveStatus}}</text>
      <button class="btn gold save-btn" loading="{{saving}}" disabled="{{!profileReady || saving || loading || uploadingPhotos || !formDirty}}" bindtap="save">{{saving ? '保存中' : formDirty ? '保存资料' : '已保存'}}</button>
    </view>
  </view>

  <view wx:if="{{previewOpen && !editingProfile}}" class="card preview-card profile-subpanel">
    <view class="profile-panel-heading">
      <view>
        <text class="section-title">档案预览</text>
      </view>
      <button class="panel-close" bindtap="togglePreview">收起</button>
    </view>
    <view class="preview-photo-shell">
      <swiper class="photo-swiper" indicator-dots circular>
        <swiper-item wx:for="{{preview.photos}}" wx:key="*this">
          <image class="photo-item" src="{{item}}" mode="aspectFill"></image>
        </swiper-item>
      </swiper>
      <text wx:if="{{!preview.hasUploadedPhotos}}" class="photo-placeholder-badge">系统示意图 · 尚未上传本人照片</text>
    </view>
    <view class="info-grid">
      <view wx:for="{{preview.baseRows}}" wx:key="label" class="info-cell">
        <text class="metric-label">{{item.label}}</text>
        <text class="metric-value small">{{item.value}}</text>
      </view>
    </view>
    <view class="info-grid">
      <view wx:for="{{preview.careerRows}}" wx:key="label" class="info-cell">
        <text class="metric-label">{{item.label}}</text>
        <text class="metric-value small">{{item.value}}</text>
      </view>
    </view>
    <view class="tag-row">
      <text wx:for="{{preview.lifeRows}}" wx:key="label" class="tag">{{item.label}}：{{item.value}}</text>
    </view>
    <view class="preview-story">
      <text class="member-label">自我介绍</text>
      <text class="item-desc">{{preview.introText}}</text>
      <view class="divider"></view>
      <text class="member-label">择偶期待</text>
      <text class="item-desc">{{preview.partnerText}}</text>
    </view>
  </view>

  </block>
</view>
