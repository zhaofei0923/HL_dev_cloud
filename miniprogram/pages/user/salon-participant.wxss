.participant-gallery { height: 640rpx; margin: -24rpx -24rpx 24rpx; border-radius: 12rpx 12rpx 0 0; overflow: hidden; }
.participant-photo { width: 100%; height: 100%; }
.profile-facts { margin-top: 16rpx; }
.profile-fact { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 1rpx solid #ece5da; }
.profile-value { color: #2f2924; font-size: 26rpx; text-align: right; }
