<view class="page recommend-page safe-bottom with-bottom-nav {{membershipKnown && !isVip ? 'with-vip-guide' : ''}}">
  <view wx:if="{{guest}}" class="card">
    <text class="eyebrow">认识 IF.U</text>
    <text class="title">找到适合自己的相遇方式</text>
    <text class="subtitle">推荐页提供会员资料浏览、条件筛选与表达喜欢。为保护会员资料，请在你愿意时登录后使用。</text>
    <text class="section-note">你也可以先浏览公开活动，了解活动安排与报名规则。</text>
    <button class="btn" bindtap="goGuestLogin">登录后使用</button>
    <button class="btn ghost" bindtap="browseActivities">浏览活动</button>
  </view>
  <block wx:else>
  <view class="recommend-topbar">
    <view class="recommend-heading">
      <view class="recommend-categories" role="tablist" aria-label="会员分类">
        <view wx:for="{{categories}}" wx:key="id"
          class="recommend-category {{category === item.id ? 'active' : ''}}"
          role="tab" aria-selected="{{category === item.id}}"
          data-category="{{item.id}}" bindtap="switchCategory">
          <text>{{item.label}}</text>
          <view wx:if="{{category === item.id}}" class="category-underline"></view>
        </view>
      </view>
    </view>
    <view class="topbar-actions">
      <button
        class="filter-trigger {{filterOpen || filterChips.length ? 'active' : ''}}"
        aria-label="筛选，已应用{{filterChips.length}}项条件"
        bindtap="toggleFilter"
      >
        <view class="filter-lines">
          <view class="filter-line line-top"></view>
          <view class="filter-line line-mid"></view>
          <view class="filter-line line-bottom"></view>
        </view>
      </button>
    </view>
  </view>

  <view wx:if="{{membershipKnown && !isVip}}" class="special-zone-vip-guide" bindtap="goMembership"
    aria-role="button" aria-label="资料免费查看，开通VIP后可聊天">
    <view class="special-zone-vip-copy">
      <text class="special-zone-vip-title">先了解，再相遇</text>
      <text class="special-zone-vip-note">资料免费查看，想聊天再开通 VIP</text>
    </view>
    <text class="special-zone-vip-action">开通 VIP ›</text>
  </view>

  <view class="distance-controls">
    <text class="section-note">{{locationEnabled ? '已开启大致距离，位置7天后过期' : '开启定位，了解彼此的大致距离'}}</text>
    <button class="distance-toggle" loading="{{locationBusy}}" disabled="{{locationBusy}}" bindtap="toggleLocation">{{locationEnabled ? '关闭定位' : '开启定位'}}</button>
  </view>

  <view wx:if="{{filterChips.length}}" class="applied-filters">
    <button wx:for="{{filterChips}}" wx:key="key" class="filter-chip" data-key="{{item.key}}"
      aria-label="移除筛选：{{item.label}}" bindtap="removeFilter">{{item.label}} ×</button>
  </view>

  <view wx:if="{{filterOpen}}" class="filter-panel">
    <view class="field search-field">
      <input
        class="field-input"
        placeholder="搜索职业、学历等关键词"
        value="{{draftKeyword}}"
        confirm-type="search"
        bindinput="onKeyword"
        bindconfirm="search"
      />
    </view>
    <view class="field compact-field">
      <input
        class="field-input"
        placeholder="城市，如：上海"
        value="{{draftCity}}"
        confirm-type="search"
        bindinput="onCity"
        bindconfirm="search"
      />
    </view>
    <view class="quick-filter-row">
      <view class="quick-filter {{draftGender === '' ? 'active' : ''}}" data-gender="" bindtap="setGender">全部</view>
      <view class="quick-filter {{draftGender === '1' ? 'active' : ''}}" data-gender="1" bindtap="setGender">男士</view>
      <view class="quick-filter {{draftGender === '2' ? 'active' : ''}}" data-gender="2" bindtap="setGender">女士</view>
    </view>
    <view class="advanced-filter-heading"><text>高级筛选</text><text class="advanced-filter-note">VIP专属</text></view>
    <view wx:if="{{!isVip}}" class="advanced-filter-lock" bindtap="goMembership">开通VIP，按年龄、学历、婚况和收入筛选 ›</view>
    <view wx:else class="advanced-filter-grid">
      <input class="field-input advanced-age" type="number" maxlength="2" placeholder="最低年龄" value="{{draftAgeMin}}" data-field="draftAgeMin" bindinput="onAdvancedInput" />
      <input class="field-input advanced-age" type="number" maxlength="2" placeholder="最高年龄" value="{{draftAgeMax}}" data-field="draftAgeMax" bindinput="onAdvancedInput" />
      <picker range="{{educationOptions}}" data-field="draftEducation" bindchange="onAdvancedPicker"><view class="advanced-picker">{{draftEducation || '不限学历'}} ›</view></picker>
      <picker range="{{maritalOptions}}" data-field="draftMaritalStatus" bindchange="onAdvancedPicker"><view class="advanced-picker">{{draftMaritalStatus || '不限婚况'}} ›</view></picker>
      <picker class="advanced-income" range="{{incomeOptions}}" data-field="draftIncomeRange" bindchange="onAdvancedPicker"><view class="advanced-picker">年收入：{{draftIncomeRange || '不限'}} ›</view></picker>
    </view>
    <view class="button-row filter-buttons">
      <button class="btn gold" loading="{{loading}}" disabled="{{loading}}" bindtap="search">应用筛选</button>
      <button class="btn secondary" disabled="{{loading}}" bindtap="clearKeyword">重置</button>
    </view>
  </view>

  <view class="recommend-stage">
    <block wx:if="{{currentMember}}">
      <view class="recommend-card-shell">
      <view
        class="recommend-card"
        bindtouchstart="onCardTouchStart"
        catchtouchmove="noop"
        bindtouchend="onCardTouchEnd"
        bindtap="onCardTap"
      >
        <image class="recommend-cover" src="{{currentMember.coverUrl}}" mode="aspectFill"></image>
        <text wx:if="{{!currentMember.hasUploadedPhotos}}" class="photo-placeholder-badge recommend-photo-placeholder">系统示意图</text>
        <view class="cover-shade"></view>
        <view class="card-top-meta">
          <view class="certification-list" aria-label="已通过的认证">
            <view wx:for="{{currentMember.certificationBadges}}" wx:key="label" class="certification-badge {{item.verified ? 'verified' : ''}}">
              <text class="certification-label">{{item.label}}</text>
            </view>
          </view>
          <text wx:if="{{positionText}}" class="position-chip">{{positionText}}</text>
        </view>

        <view wx:if="{{actionEffect}}" class="action-flyout action-flyout-{{actionEffect}}">
          <view wx:if="{{actionEffect === 'gift'}}" class="flyout-icon flyout-gift">
            <view class="gift-shape">
              <view class="gift-bow"></view>
              <view class="gift-box"></view>
            </view>
          </view>
          <view wx:elif="{{actionEffect === 'heart'}}" class="flyout-icon flyout-heart">
            <view class="heart-shape"></view>
          </view>
          <view wx:else class="flyout-icon flyout-hide">
            <view class="x-shape">
              <view class="x-line x-left"></view>
              <view class="x-line x-right"></view>
            </view>
          </view>
        </view>

        <view class="member-overlay">
          <view class="name-line">
            <text class="recommend-name">{{currentMember.displayName}}</text>
            <text wx:if="{{currentMember.vipBadge}}" class="member-vip-badge">VIP</text>
          </view>
          <text class="recommend-meta">{{currentMember.primaryMeta}}</text>
          <text wx:if="{{currentMember.distanceText}}" class="recommend-meta">{{currentMember.distanceText}}</text>
          <text class="recommend-work">{{currentMember.ageText}}{{currentMember.profileLine ? ' · ' + currentMember.profileLine : ''}}</text>
          <view wx:if="{{currentMember.cardTags.length}}" class="card-tag-row">
            <text wx:for="{{currentMember.cardTags}}" wx:key="*this" class="card-tag">{{item}}</text>
          </view>
          <view wx:if="{{currentMember.financialAssetText}}" class="card-tag-row">
            <text class="card-tag">已核验金融资产：{{currentMember.financialAssetText}}</text>
          </view>
          <view class="quote-block">
            <text class="quote-mark">“</text>
            <text class="quote-text">{{currentMember.partnerPreview}}</text>
          </view>
        </view>
      </view>
      <view class="quick-actions" aria-label="会员操作">
        <button class="quick-action" hover-class="action-icon-hover"
          aria-label="赠送礼物" disabled="{{loading || giftLoading || favoriteLoading || hideLoading || sendingGiftId !== '' || actionAnimating || giftPanelOpen}}"
          bindtap="openGiftPanel">
          <view class="action-icon action-gift"><view class="gift-shape"><view class="gift-bow"></view><view class="gift-box"></view></view></view>
        </button>
        <button class="quick-action" hover-class="action-icon-hover"
          aria-label="{{currentMember.isFavorite ? '撤回爱心' : '送爱心'}}" disabled="{{loading || favoriteLoading || hideLoading || sendingGiftId !== '' || actionAnimating || giftPanelOpen}}"
          bindtap="toggleFavorite">
          <view class="action-icon action-heart {{currentMember.isFavorite ? 'active' : ''}}"><view class="heart-shape"></view></view>
        </button>
        <button class="quick-action" hover-class="action-icon-hover"
          aria-label="不再查看该会员" disabled="{{loading || hideLoading || favoriteLoading || sendingGiftId !== '' || actionAnimating || giftPanelOpen || filterOpen}}"
          bindtap="hideCurrent">
          <view class="action-icon action-hide"><view class="x-shape"><view class="x-line x-left"></view><view class="x-line x-right"></view></view></view>
        </button>
      </view>
      </view>

      <view wx:if="{{loadingMore || paginationError}}" class="pagination-note">
        <text>{{loadingMore ? '正在准备更多会员' : paginationError}}</text>
        <text wx:if="{{paginationError && !loadingMore}}" class="pagination-retry" bindtap="loadMoreShowcase">重试</text>
      </view>
    </block>

    <view wx:else class="recommend-empty">
      <text class="empty-title">{{loading ? '正在加载会员' : emptyTitle}}</text>
      <text class="empty-note">{{loading ? '请稍候，正在整理可公开展示的会员资料。' : emptyNote}}</text>
      <view class="button-row empty-buttons">
        <button class="btn gold" loading="{{loading}}" disabled="{{loading}}" bindtap="load">重新加载</button>
        <button class="btn ghost" bindtap="toggleFilter">调整筛选</button>
      </view>
      <button class="btn secondary profile-entry" bindtap="goProfile">完善我的资料</button>
    </view>
  </view>

  <view wx:if="{{giftPanelOpen}}" class="gift-mask" catchtap="closeGiftPanel" catchtouchmove="noop"></view>
  <view wx:if="{{giftPanelOpen}}" class="gift-panel" catchtap="noop">
    <view class="gift-panel-head">
      <view>
        <text class="gift-panel-title">赠送给 {{currentMember.displayName}}</text>
        <text class="gift-panel-subtitle">免费虚拟礼物 · 点击即送出，同时表达喜欢</text>
      </view>
      <view
        class="gift-close {{sendingGiftId !== '' ? 'disabled' : ''}}"
        aria-label="关闭"
        hover-class="gift-close-hover"
        catchtap="closeGiftPanel"
      >
        <view class="x-shape small">
          <view class="x-line x-left"></view>
          <view class="x-line x-right"></view>
        </view>
      </view>
    </view>
    <scroll-view class="gift-panel-scroll" scroll-y>
    <view class="gift-list">
      <button
        wx:for="{{gifts}}"
        wx:key="id"
        class="gift-item"
        data-gift-id="{{item.id}}"
        loading="{{sendingGiftId === item.id}}"
        disabled="{{giftLoading || sendingGiftId !== '' || actionAnimating}}"
        catchtap="sendGift"
      >
        <view class="gift-icon gift-{{item.tone}}">{{item.symbol}}</view>
        <view class="gift-copy">
          <text class="gift-name">{{item.name}}</text>
          <text class="gift-description">{{item.description}}</text>
        </view>
      </button>
      <view wx:if="{{giftLoading && !gifts.length}}" class="gift-loading">正在加载礼品库</view>
      <view wx:if="{{!giftLoading && !gifts.length}}" class="gift-loading">礼品库暂不可用</view>
    </view>
    </scroll-view>
  </view>

  </block>
</view>
