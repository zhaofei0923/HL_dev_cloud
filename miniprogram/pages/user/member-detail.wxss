.detail-page {
  padding-top: 20rpx;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.detail-gallery-card {
  position: relative;
  height: 720rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #241f1b;
  box-shadow: 0 16rpx 36rpx rgba(56, 42, 29, 0.13);
}

.detail-gallery,
.detail-photo,
.detail-gallery-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.detail-photo {
  display: block;
}

.detail-gallery-shade {
  z-index: 2;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(36, 31, 27, 0.03) 38%, rgba(36, 31, 27, 0.84) 100%);
}

.photo-count {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  z-index: 3;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(36, 31, 27, 0.54);
  color: #fffdf8;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
}

.detail-photo-placeholder {
  top: 22rpx;
  left: 22rpx;
}

.detail-identity {
  position: absolute;
  right: 28rpx;
  bottom: 36rpx;
  left: 28rpx;
  z-index: 3;
}

.detail-name,
.detail-meta {
  display: block;
  color: #fffdf8;
  text-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.28);
}

.detail-name {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.18;
}

.detail-meta {
  margin-top: 10rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.42;
}

.hero-tags {
  margin-top: 16rpx;
}

.detail-section {
  margin-top: 20rpx;
  box-shadow: none;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.info-cell {
  box-sizing: border-box;
  min-height: 104rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(151, 119, 82, 0.12);
  border-radius: 12rpx;
  background: rgba(248, 243, 235, 0.58);
}

.compact-grid {
  margin-top: 18rpx;
}

.life-tags {
  margin-top: 16rpx;
}

.story-label,
.story-text {
  display: block;
}

.story-label {
  color: #8f6544;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.story-text {
  margin-top: 10rpx;
  color: #4f4944;
  font-size: 27rpx;
  line-height: 1.72;
}

.privacy-note {
  margin-top: 18rpx;
  padding: 0 8rpx;
}

.privacy-note-title,
.privacy-note-copy {
  display: block;
}

.privacy-note-title {
  color: #6b625c;
  font-size: 23rpx;
  font-weight: 800;
}

.privacy-note-copy {
  margin-top: 6rpx;
  color: #91877f;
  font-size: 22rpx;
  line-height: 1.5;
}

.detail-action-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: grid;
  grid-template-columns: 220rpx minmax(0, 1fr);
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(151, 119, 82, 0.16);
  background: rgba(255, 253, 248, 0.97);
  box-shadow: 0 -12rpx 30rpx rgba(56, 42, 29, 0.08);
}

.detail-secondary-action,
.detail-primary-action {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.detail-secondary-action {
  border: 1rpx solid rgba(151, 119, 82, 0.24);
  background: #fffdf8;
  color: #6e4d35;
}

.detail-primary-action {
  border: 1rpx solid #8f493f;
  background: #8f493f;
  color: #fffdf8;
}

.detail-secondary-action::after,
.detail-primary-action::after {
  border: 0;
}

.detail-primary-action[disabled] {
  opacity: 0.58;
}

.empty-btn {
  margin-top: 20rpx;
}
