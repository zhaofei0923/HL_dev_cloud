<view class="page safe-bottom detail-page">
  <block wx:if="{{member}}">
    <view class="detail-gallery-card">
      <swiper class="detail-gallery" indicator-dots circular indicator-color="rgba(255,255,255,0.48)" indicator-active-color="#fffdf8">
        <swiper-item wx:for="{{member.photos}}" wx:key="*this">
          <image class="detail-photo" src="{{item}}" mode="aspectFill"></image>
        </swiper-item>
      </swiper>
      <view class="detail-gallery-shade"></view>
      <text wx:if="{{!member.hasUploadedPhotos}}" class="photo-placeholder-badge detail-photo-placeholder">系统示意图</text>
      <text class="photo-count">{{member.photos.length}} 张照片</text>
      <view class="detail-identity">
        <view class="detail-name-line">
          <text class="detail-name">{{member.displayName}}</text>
          <text wx:if="{{member.vipBadge}}" class="detail-vip-badge">VIP</text>
          <text class="detail-meta">{{member.metaText}}</text>
        </view>
        <text class="detail-work">{{member.workText}}</text>
        <view class="tag-row hero-tags">
          <text wx:for="{{member.profileTags}}" wx:key="*this" class="tag gold">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="card info-card detail-section">
      <text class="section-title">基本信息</text>
      <view class="info-grid">
        <view wx:for="{{member.baseRows}}" wx:key="label" class="info-cell">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value small">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="card info-card detail-section">
      <text class="section-title">职业与背景</text>
      <view class="info-grid">
        <view wx:for="{{member.careerRows}}" wx:key="label" class="info-cell">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value small">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{certificationRows.length}}" class="card info-card detail-section">
      <text class="section-title">认证信息</text>
      <view class="detail-fact-list">
        <view wx:for="{{certificationRows}}" wx:key="label" class="detail-fact-row">
          <text class="metric-label">{{item.label}}</text>
          <text class="detail-fact-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="card info-card detail-section">
      <text class="section-title">生活情况</text>
      <view class="detail-fact-list">
        <view wx:for="{{member.lifeRows}}" wx:key="label" class="detail-fact-row">
          <text class="metric-label">{{item.label}}</text>
          <text class="detail-fact-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="card story-card detail-section">
      <text class="section-title">关于我</text>
      <text class="item-desc story-text">{{member.introText}}</text>
    </view>

    <view class="card story-card detail-section">
      <text class="section-title">期待的关系</text>
      <text class="item-desc story-text">{{member.partnerText}}</text>
    </view>

    <view wx:if="{{member.userId}}" class="card detail-section detail-privileges">
      <text class="section-title">进一步了解TA</text>
      <view class="detail-privilege-buttons">
        <button class="detail-privilege-button" data-section="exchanges" disabled="{{loading}}" bindtap="goPrivilege">交换微信 · VIP</button>
        <button class="detail-privilege-button" data-section="online" disabled="{{loading}}" bindtap="goPrivilege">上线提醒 · VIP</button>
        <button class="detail-privilege-button" data-section="matchmaking" disabled="{{loading}}" bindtap="goPrivilege">申请人工牵线</button>
      </view>
    </view>

    <view class="detail-action-dock">
      <button wx:if="{{isFavorite && !loading}}" class="detail-secondary-action" disabled="{{favoriteLoading || chatStarting}}" bindtap="toggleFavorite">撤回爱心</button>
      <button wx:else class="detail-secondary-action" bindtap="goBack">返回推荐</button>
      <button class="detail-primary-action" loading="{{chatStarting || favoriteLoading}}"
        disabled="{{loading || chatStarting || favoriteLoading || (chatAccess === 'unavailable' && isFavorite)}}" bindtap="primaryAction">{{loading ? '确认中' : chatAccess === 'unknown' ? '刷新互动状态' : chatAccess === 'allowed' ? '发消息' : chatAccess === 'membership_required' ? '开通VIP聊天' : isFavorite ? '已送出爱心' : '送爱心'}}</button>
    </view>
  </block>

  <view wx:else class="empty">
    <text class="empty-title">{{loading ? '正在加载档案' : unavailable ? '资料暂不可查看' : '资料加载失败'}}</text>
    <text wx:if="{{!loading && loadError}}" class="empty-note">{{loadError}}</text>
    <button wx:if="{{!loading && !unavailable}}" class="btn gold empty-btn" bindtap="load">重新加载</button>
    <button class="btn ghost empty-btn" bindtap="goBack">返回</button>
  </view>
</view>
