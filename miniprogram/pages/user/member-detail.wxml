<view class="page safe-bottom detail-page">
  <block wx:if="{{member}}">
    <view class="detail-gallery-card">
      <swiper class="detail-gallery" indicator-dots circular indicator-color="rgba(255,255,255,0.48)" indicator-active-color="#fffdf8">
        <swiper-item wx:for="{{member.photos}}" wx:key="*this">
          <image class="detail-photo" src="{{item}}" mode="aspectFill"></image>
        </swiper-item>
      </swiper>
      <view class="detail-gallery-shade"></view>
      <text wx:if="{{!member.hasUploadedPhotos}}" class="photo-placeholder-badge detail-photo-placeholder">系统示意图 · 尚未上传本人照片</text>
      <text class="photo-count">{{member.photos.length}} 张照片</text>
      <view class="detail-identity">
        <view class="detail-name-line">
          <text class="detail-name">{{member.displayName}}</text>
          <text class="detail-meta">{{member.metaText}}</text>
        </view>
        <text class="detail-work">{{member.workText}}</text>
        <view class="tag-row hero-tags">
          <text wx:for="{{member.profileTags}}" wx:key="*this" class="tag gold">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="detail-scroll-cue">
      <text>向下滑动查看详细资料</text>
      <view class="detail-scroll-chevron"></view>
    </view>

    <view class="detail-content-heading">
      <text class="detail-content-title">详细资料</text>
      <text class="detail-content-note">了解 TA 的生活与期待</text>
    </view>

    <view class="card info-card detail-section">
      <text class="section-title">基本信息</text>
      <view class="info-grid">
        <view wx:for="{{member.baseRows}}" wx:key="label" class="info-cell">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value small">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="card info-card detail-section">
      <text class="section-title">职业与背景</text>
      <view class="info-grid">
        <view wx:for="{{member.careerRows}}" wx:key="label" class="info-cell">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value small">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="card info-card detail-section">
      <text class="section-title">生活情况</text>
      <view class="detail-fact-list">
        <view wx:for="{{member.lifeRows}}" wx:key="label" class="detail-fact-row">
          <text class="metric-label">{{item.label}}</text>
          <text class="detail-fact-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="card story-card detail-section">
      <text class="section-title">关于我</text>
      <text class="item-desc story-text">{{member.introText}}</text>
    </view>

    <view class="card story-card detail-section">
      <text class="section-title">期待的关系</text>
      <text class="item-desc story-text">{{member.partnerText}}</text>
    </view>

    <view class="privacy-note">
      <text class="privacy-note-title">隐私说明</text>
      <text class="privacy-note-copy">婚况、房产与车辆概况属于公开匹配资料；联系方式、验资材料、主理人备注和内部服务记录不会公开。</text>
    </view>

    <view class="detail-action-dock">
      <button class="detail-secondary-action" bindtap="goProfile">我的资料</button>
      <button class="detail-primary-action" loading="{{chatStarting}}" disabled="{{chatStarting}}" bindtap="startChat">发消息</button>
    </view>
  </block>

  <view wx:else class="empty">
    <text class="empty-title">{{loading ? '正在加载档案' : '未找到会员档案'}}</text>
    <text class="empty-note">{{loading ? '请稍候，正在整理会员资料。' : '请返回推荐页重新选择。'}}</text>
    <button class="btn ghost empty-btn" bindtap="goBack">返回</button>
  </view>
</view>
