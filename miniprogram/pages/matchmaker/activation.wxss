.activation-page { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.activation-heading { padding: 24rpx 4rpx 30rpx; }
.activation-plan { padding: 28rpx; background: #fffdf9; }
.activation-plan-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.activation-price-row { display: flex; align-items: baseline; gap: 14rpx; margin: 26rpx 0 20rpx; }
.activation-price { color: #a35d45; font-size: 64rpx; font-weight: 800; line-height: 1.2; }
.activation-term { color: #736256; font-size: 24rpx; }
.activation-benefit { display: flex; justify-content: space-between; gap: 22rpx; padding: 22rpx 0; border-top: 1rpx solid rgba(151,119,82,.14); color: #2f2924; font-size: 25rpx; line-height: 1.5; }
.activation-benefit text:first-child { flex-shrink: 0; font-weight: 700; }
.activation-benefit text:last-child { color: #736256; text-align: right; }
.activation-footnote { display: block; margin-top: 20rpx; color: #8a7b6e; font-size: 23rpx; line-height: 1.65; }
.activation-state { color: #736256; font-size: 25rpx; line-height: 1.6; }
.activation-error { display: block; margin-bottom: 24rpx; color: #a35d45; }
.activation-button { width: 100%; box-sizing: border-box; margin: 24rpx 0 0; }
.activation-order-number { display: block; margin-top: 18rpx; color: #8a7b6e; font-size: 21rpx; overflow-wrap: anywhere; }
.activation-links { display: flex; gap: 36rpx; padding: 18rpx 4rpx; color: #a35d45; font-size: 24rpx; }
