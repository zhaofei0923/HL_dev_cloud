<view class="page safe-bottom {{canOperate ? 'with-bottom-nav' : ''}}">
  <view class="mine-header">
    <text class="eyebrow">我的</text>
    <text class="title">主理人中心</text>
  </view>

  <view class="card identity-card">
    <image wx:if="{{user.avatarUrl}}" class="identity-avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
    <view wx:else class="identity-avatar fallback">主</view>
    <view class="identity-copy">
      <view class="identity-name-row">
        <text class="identity-name">{{user.nickname || '主理人'}}</text>
        <text class="tag {{statusTagClass}}">{{statusText}}</text>
      </view>
      <text class="identity-number">{{dashboard.matchmaker.matchmakerNo || '专属编号待确认'}}</text>
      <text class="identity-note">{{canOperate ? '主理人等级 L' + (dashboard.matchmaker.level || 1) : statusNote}}</text>
    </view>
  </view>

  <view wx:if="{{canOperate}}" class="card invite-card">
    <view class="invite-entry" bindtap="toggleInvite">
      <view class="invite-entry-copy">
        <text class="section-title">邀请会员</text>
        <text class="section-note">分享注册链接或邀请码</text>
      </view>
      <text class="invite-status">{{inviteCard.inviteCodeStatus === 'inactive' ? '已失效' : '有效'}}</text>
      <text class="invite-arrow">{{inviteOpen ? '⌃' : '›'}}</text>
    </view>

    <view wx:if="{{inviteOpen}}" class="invite-body">
      <view class="invite-panel">
        <view class="invite-code-box">
          <text class="field-label">邀请码</text>
          <text class="invite-code">{{inviteCard.inviteCode || '生成中'}}</text>
          <text class="invite-help">好友注册后会成为你的免费会员</text>
        </view>
        <view class="invite-qr-box" bindtap="previewInviteQr">
          <image wx:if="{{inviteCard.qrCodeFileID}}" class="invite-qr" src="{{inviteCard.qrCodeFileID}}" mode="aspectFit"></image>
          <text wx:else class="invite-qr-placeholder">{{inviteLoading ? '生成中' : '二维码待生成'}}</text>
        </view>
      </view>
      <view class="button-row invite-actions">
        <button class="btn secondary" bindtap="copyInviteCode">复制邀请码</button>
        <button class="btn gold" open-type="share">分享注册链接</button>
      </view>
      <button class="reset-link" loading="{{inviteResetting}}" disabled="{{inviteResetting}}" bindtap="resetInviteCode">重置邀请码</button>
    </view>
  </view>

  <view class="card settings-card">
    <text class="section-title">账号设置</text>
    <view class="settings-list">
      <view class="settings-row">
        <text class="settings-label">开通状态</text>
        <text class="settings-value">{{statusText}}</text>
      </view>
      <view class="settings-row">
        <text class="settings-label">账号身份</text>
        <text class="settings-value">{{canOperate ? '主理人' : '尚未开通'}}</text>
      </view>
    </view>
    <text wx:if="{{!canOperate}}" class="settings-note">{{statusNote}}</text>
    <button class="btn secondary settings-action" loading="{{loading}}" disabled="{{loading}}" bindtap="goActivation">{{canOperate ? '查看开通状态' : '查看开通方案'}}</button>
    <button class="logout-button" bindtap="logout">{{canOperate ? '退出工作台' : '返回登录'}}</button>
  </view>

  <bottom-nav wx:if="{{canOperate}}" role="matchmaker" active="mine"></bottom-nav>
</view>
