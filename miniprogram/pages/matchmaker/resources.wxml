<view class="page safe-bottom resources-page">
  <view class="resources-header">
    <text class="eyebrow">会员协作</text>
    <text class="title">合作资源</text>
    <text class="subtitle">浏览其他主理人的可展示会员</text>
  </view>

  <view class="service-context">
    <view class="context-main">
      <text class="context-label">当前服务会员</text>
      <text class="context-name">{{primaryMemberName || '尚未选择'}}</text>
      <text class="context-note">{{accessNote}}</text>
    </view>
    <button wx:if="{{memberOptions.length}}" class="change-member" bindtap="toggleMemberSelector">{{selectorOpen ? '收起' : '更换'}}</button>
  </view>

  <view wx:if="{{selectorOpen && memberOptions.length}}" class="card member-selector-card">
    <text class="section-title">选择服务会员</text>
    <text class="section-note">后续互推将以这位会员发起</text>
    <picker mode="selector" range="{{memberOptions}}" value="{{selectedMemberIndex}}" bindchange="onMemberChange">
      <view class="member-picker">
        <text class="field-label">我的会员</text>
        <text class="picker-value">{{primaryMemberName}}</text>
      </view>
    </picker>
  </view>

  <view class="card list-shell resources-list-shell">
    <view class="row list-header">
      <view>
        <text class="section-title">可协作会员</text>
        <text class="section-note">{{loading ? '正在更新资源' : total + ' 位会员'}}</text>
      </view>
      <text class="permission-hint">认证资源</text>
    </view>

    <block wx:if="{{list.length}}">
      <view wx:for="{{list}}" wx:key="id" class="resource-item">
        <image class="resource-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view class="resource-copy" data-id="{{item.id}}" bindtap="openDetail">
          <view class="resource-name-row">
            <text class="item-title resource-name">{{item.displayName}}</text>
            <text class="income-text">{{item.incomeText}}</text>
          </view>
          <text class="item-meta">{{item.metaText}}</text>
          <text class="item-meta resource-work">{{item.occupationText}}</text>
          <text class="detail-link">查看资料 ›</text>
        </view>
        <button class="recommend-action" data-user-id="{{item.userId}}" loading="{{recommendLoadingId === item.userIdText}}" disabled="{{recommendLoadingId === item.userIdText || !primaryMemberName}}" bindtap="recommend">互推</button>
      </view>
    </block>

    <view wx:else class="empty">
      <text class="empty-title">{{loading ? '正在加载资源' : '暂无可展示资源'}}</text>
      <text class="empty-note">{{loading ? '请稍候，正在整理认证资源。' : '暂时没有符合展示条件的合作会员。'}}</text>
    </view>
  </view>
</view>
