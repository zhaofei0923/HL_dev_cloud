<view wx:if="{{canOperate}}" class="page safe-bottom with-bottom-nav">
  <view class="dashboard-header">
    <view class="dashboard-heading">
      <text class="eyebrow">工作台</text>
      <text class="title">{{user.nickname || '主理人'}}，你好</text>
      <text class="subtitle">先处理今天最重要的会员服务事项。</text>
    </view>
    <text class="tag {{statusTagClass}}">{{statusText}}</text>
  </view>

  <view class="card todo-card">
    <view class="row section-head">
      <view>
        <text class="section-title">今日待办</text>
        <text class="section-note">{{loading ? '正在整理待办' : '按优先级逐项处理'}}</text>
      </view>
      <text class="todo-state">{{loading ? '刷新中' : '待处理'}}</text>
    </view>

    <view class="todo-list">
      <view class="todo-row" bindtap="goMembers">
        <view class="todo-index urgent">1</view>
        <view class="todo-copy">
          <text class="todo-title">完善会员资料</text>
          <text class="todo-note">资料不完整的会员需要补充</text>
        </view>
        <text class="todo-count">{{dashboard.todoCounts.incompleteMembers || dashboard.operations.todoCounts.incompleteMembers || 0}}</text>
        <text class="todo-arrow">›</text>
      </view>
      <view class="todo-row" bindtap="goResources">
        <view class="todo-index">2</view>
        <view class="todo-copy">
          <text class="todo-title">跟进会员互推</text>
          <text class="todo-note">查看仍在沟通中的推荐</text>
        </view>
        <text class="todo-count">{{dashboard.todoCounts.pendingRecommendations || dashboard.operations.todoCounts.pendingRecommendations || 0}}</text>
        <text class="todo-arrow">›</text>
      </view>
      <view class="todo-row" bindtap="goSalon">
        <view class="todo-index">3</view>
        <view class="todo-copy">
          <text class="todo-title">查看活动报名</text>
          <text class="todo-note">确认近期活动和报名情况</text>
        </view>
        <text class="todo-count">{{dashboard.registrationCount || dashboard.operations.registrationCount || 0}}</text>
        <text class="todo-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card quick-card">
    <text class="section-title">快捷入口</text>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goMembers">
        <view class="quick-icon">员</view>
        <text class="quick-title">会员管理</text>
        <text class="quick-note">录入与查找</text>
      </view>
      <view class="quick-item" bindtap="goResources">
        <view class="quick-icon">协</view>
        <text class="quick-title">合作资源</text>
        <text class="quick-note">浏览与互推</text>
      </view>
      <view class="quick-item" bindtap="goSalon">
        <view class="quick-icon">活</view>
        <text class="quick-title">活动管理</text>
        <text class="quick-note">创建与报名</text>
      </view>
    </view>
  </view>

  <view class="overview-row">
    <view class="overview-item">
      <text class="overview-value">{{dashboard.matchmaker.memberCount || 0}}</text>
      <text class="overview-label">名下会员</text>
    </view>
    <view class="overview-item">
      <text class="overview-value">{{dashboard.resourceCount || dashboard.operations.resourceCount || 0}}</text>
      <text class="overview-label">合作资源</text>
    </view>
    <view class="overview-item">
      <text class="overview-value">{{dashboard.operations.salonCount || 0}}</text>
      <text class="overview-label">我的活动</text>
    </view>
  </view>

  <bottom-nav role="matchmaker" active="dashboard"></bottom-nav>
</view>

<view wx:else class="page safe-bottom">
  <view class="card approval-hero">
    <text class="eyebrow">主理人申请</text>
    <text class="title">{{statusText}}</text>
    <text class="subtitle">{{loading ? '正在确认主理人申请状态。' : statusNote}}</text>
    <view class="summary-strip">
      <view class="summary-item">
        <text class="summary-value">{{statusText}}</text>
        <text class="summary-label">申请状态</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">后台</text>
        <text class="summary-label">审批处理</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">通过</text>
        <text class="summary-label">开放工作台</text>
      </view>
    </view>
  </view>

  <view class="card approval-card">
    <view class="row approval-head">
      <view>
        <text class="section-title">申请进度</text>
        <text class="section-note">{{loading ? '请稍候，正在读取最新申请状态。' : statusNote}}</text>
      </view>
      <text class="tag {{statusTagClass}}">{{loading ? '确认中' : statusText}}</text>
    </view>
    <view class="approval-flow">
      <view class="flow-item active">
        <text class="flow-dot">1</text>
        <text class="flow-copy">提交申请</text>
      </view>
      <view class="flow-item {{dashboard.matchmaker.certificationStatus === 0 ? 'active' : ''}}">
        <text class="flow-dot">2</text>
        <text class="flow-copy">后台审批</text>
      </view>
      <view class="flow-item {{dashboard.matchmaker.certificationStatus === 2 ? 'active' : ''}}">
        <text class="flow-dot">3</text>
        <text class="flow-copy">开通工作台</text>
      </view>
    </view>
    <button wx:if="{{dashboard.matchmaker.certificationStatus === 1}}" class="btn gold approval-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="applyAgain">重新提交申请</button>
    <button class="btn ghost approval-btn" bindtap="goUserProfile">返回我的</button>
  </view>
</view>
