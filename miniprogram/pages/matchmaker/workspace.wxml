<!-- Generated by scripts/sync-matchmaker-workspace.mjs. Edit the source page views. -->
<template name="dashboard">
<view wx:if="{{canOperate}}" class="page safe-bottom with-bottom-nav">
  <view class="dashboard-header">
    <view class="dashboard-heading">
      <text class="eyebrow">工作台</text>
      <text class="title">{{user.nickname || '主理人'}}，你好</text>
      <text class="subtitle">先处理今天最重要的会员服务事项。</text>
    </view>
    <text class="tag {{statusTagClass}}">{{statusText}}</text>
  </view>

  <view class="card todo-card">
    <view class="row section-head">
      <view>
        <text class="section-title">今日待办</text>
        <text class="section-note">{{loading ? '正在整理待办' : '按优先级逐项处理'}}</text>
      </view>
      <text class="todo-state">{{loading ? '刷新中' : '待处理'}}</text>
    </view>

    <view class="todo-list">
      <view class="todo-row" bindtap="workspace_dashboard_goMembers">
        <view class="todo-index urgent">1</view>
        <view class="todo-copy">
          <text class="todo-title">完善会员资料</text>
          <text class="todo-note">资料不完整的会员需要补充</text>
        </view>
        <text class="todo-count">{{dashboard.todoCounts.incompleteMembers || dashboard.operations.todoCounts.incompleteMembers || 0}}</text>
        <text class="todo-arrow">›</text>
      </view>
      <view class="todo-row" bindtap="workspace_dashboard_goResources">
        <view class="todo-index">2</view>
        <view class="todo-copy">
          <text class="todo-title">跟进会员互推</text>
          <text class="todo-note">查看仍在沟通中的推荐</text>
        </view>
        <text class="todo-count">{{dashboard.todoCounts.pendingRecommendations || dashboard.operations.todoCounts.pendingRecommendations || 0}}</text>
        <text class="todo-arrow">›</text>
      </view>
      <view class="todo-row" bindtap="workspace_dashboard_goSalon">
        <view class="todo-index">3</view>
        <view class="todo-copy">
          <text class="todo-title">查看活动报名</text>
          <text class="todo-note">确认近期活动和报名情况</text>
        </view>
        <text class="todo-count">{{dashboard.registrationCount || dashboard.operations.registrationCount || 0}}</text>
        <text class="todo-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card quick-card">
    <text class="section-title">快捷入口</text>
    <view class="quick-grid">
      <view class="quick-item" bindtap="workspace_dashboard_goMembers">
        <view class="quick-icon">员</view>
        <text class="quick-title">会员管理</text>
        <text class="quick-note">录入与查找</text>
      </view>
      <view class="quick-item" bindtap="workspace_dashboard_goResources">
        <view class="quick-icon">协</view>
        <text class="quick-title">合作资源</text>
        <text class="quick-note">浏览与互推</text>
      </view>
      <view class="quick-item" bindtap="workspace_dashboard_goSalon">
        <view class="quick-icon">活</view>
        <text class="quick-title">活动管理</text>
        <text class="quick-note">创建与报名</text>
      </view>
    </view>
  </view>

  <view class="overview-row">
    <view class="overview-item">
      <text class="overview-value">{{dashboard.matchmaker.memberCount || 0}}</text>
      <text class="overview-label">名下会员</text>
    </view>
    <view class="overview-item">
      <text class="overview-value">{{dashboard.resourceCount || dashboard.operations.resourceCount || 0}}</text>
      <text class="overview-label">合作资源</text>
    </view>
    <view class="overview-item">
      <text class="overview-value">{{dashboard.operations.salonCount || 0}}</text>
      <text class="overview-label">我的活动</text>
    </view>
  </view>


</view>

<view wx:else class="page safe-bottom">
  <view class="card approval-hero">
    <text class="eyebrow">主理人申请</text>
    <text class="title">{{statusText}}</text>
    <text class="subtitle">{{loading ? '正在确认主理人申请状态。' : statusNote}}</text>
    <view class="summary-strip">
      <view class="summary-item">
        <text class="summary-value">{{statusText}}</text>
        <text class="summary-label">申请状态</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">后台</text>
        <text class="summary-label">审批处理</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">通过</text>
        <text class="summary-label">开放工作台</text>
      </view>
    </view>
  </view>

  <view class="card approval-card">
    <view class="row approval-head">
      <view>
        <text class="section-title">申请进度</text>
        <text class="section-note">{{loading ? '请稍候，正在读取最新申请状态。' : statusNote}}</text>
      </view>
      <text class="tag {{statusTagClass}}">{{loading ? '确认中' : statusText}}</text>
    </view>
    <view class="approval-flow">
      <view class="flow-item active">
        <text class="flow-dot">1</text>
        <text class="flow-copy">提交申请</text>
      </view>
      <view class="flow-item {{dashboard.matchmaker.certificationStatus === 0 ? 'active' : ''}}">
        <text class="flow-dot">2</text>
        <text class="flow-copy">后台审批</text>
      </view>
      <view class="flow-item {{dashboard.matchmaker.certificationStatus === 2 ? 'active' : ''}}">
        <text class="flow-dot">3</text>
        <text class="flow-copy">开通工作台</text>
      </view>
    </view>
    <button wx:if="{{dashboard.matchmaker.certificationStatus === 1}}" class="btn gold approval-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_dashboard_applyAgain">重新提交申请</button>
    <button class="btn ghost approval-btn" bindtap="workspace_dashboard_goUserProfile">返回我的</button>
  </view>
</view>
</template>

<template name="members">
<view class="page safe-bottom {{canOperate ? 'with-bottom-nav' : ''}}">
  <block wx:if="{{canOperate}}">
    <view class="members-header">
      <view class="members-heading">
        <text class="eyebrow">会员管理</text>
        <text class="title">我的会员</text>
        <text class="subtitle">{{total}} 位会员</text>
      </view>
      <button class="add-member-btn" bindtap="workspace_members_goAdd">＋ 录入会员</button>
    </view>

    <view class="card search-card">
      <view class="search-bar">
        <text class="search-icon">⌕</text>
        <input class="search-input" value="{{keyword}}" bindinput="workspace_members_onKeyword" confirm-type="search" bindconfirm="workspace_members_load" placeholder="搜索姓名、城市或职业" />
        <button class="search-submit" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_members_load">搜索</button>
      </view>
      <view class="quick-filter-row">
        <view class="quick-filter {{gender === '' ? 'active' : ''}}" data-gender="" bindtap="workspace_members_setGender">全部</view>
        <view class="quick-filter {{gender === '1' ? 'active' : ''}}" data-gender="1" bindtap="workspace_members_setGender">男士</view>
        <view class="quick-filter {{gender === '2' ? 'active' : ''}}" data-gender="2" bindtap="workspace_members_setGender">女士</view>
        <view class="quick-filter filter-trigger {{filtersOpen ? 'active' : ''}}" bindtap="workspace_members_toggleFilters">筛选{{filtersOpen ? '收起' : ''}}</view>
      </view>
      <view wx:if="{{filtersOpen}}" class="advanced-filters">
        <view class="field filter-field">
          <text class="field-label">城市</text>
          <input class="field-input" value="{{city}}" bindinput="workspace_members_onCity" confirm-type="search" bindconfirm="workspace_members_load" placeholder="输入城市" />
        </view>
        <view class="filter-grid">
          <picker mode="selector" range="{{memberTypeOptions}}" bindchange="workspace_members_onMemberTypeChange">
            <view class="field picker-field">
              <text class="field-label">会员类型</text>
              <text class="field-input picker-value">{{memberTypeLabel}}</text>
            </view>
          </picker>
          <picker mode="selector" range="{{serviceLevelOptions}}" bindchange="workspace_members_onServiceLevelChange">
            <view class="field picker-field">
              <text class="field-label">服务等级</text>
              <text class="field-input picker-value">{{serviceLevelLabel}}</text>
            </view>
          </picker>
        </view>
        <view class="button-row filter-actions">
          <button class="btn gold" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_members_load">应用筛选</button>
          <button class="btn ghost" disabled="{{loading}}" bindtap="workspace_members_clearFilters">重置</button>
        </view>
      </view>
    </view>

    <view wx:if="{{pendingRequests.length}}" class="notice-entry {{approvalsOpen ? 'open' : ''}}" bindtap="workspace_members_toggleApprovals">
      <view class="notice-dot"></view>
      <view class="notice-copy">
        <text class="notice-title">会员申请待处理</text>
        <text class="notice-note">{{pendingRequests.length}} 位会员申请由你服务</text>
      </view>
      <text class="notice-count">{{pendingRequests.length}}</text>
      <text class="notice-arrow">{{approvalsOpen ? '⌃' : '›'}}</text>
    </view>

    <view wx:if="{{pendingRequests.length && approvalsOpen}}" class="card request-card">
      <view wx:for="{{pendingRequests}}" wx:key="id" class="request-item">
        <view class="request-copy">
          <text class="item-title">{{item.displayName}}</text>
          <text class="item-meta">{{item.metaText}}</text>
          <text class="item-desc">{{item.noteText}}</text>
        </view>
        <view class="request-actions">
          <button class="btn gold small-btn" data-id="{{item.id}}" loading="{{requestProcessingId === item.idText}}" disabled="{{requestProcessingId === item.idText}}" catchtap="workspace_members_approveRequest">通过</button>
          <button class="btn danger small-btn" data-id="{{item.id}}" disabled="{{requestProcessingId === item.idText}}" catchtap="workspace_members_rejectRequest">拒绝</button>
        </view>
      </view>
    </view>

    <view class="card list-shell members-list-shell">
      <view class="row list-header">
        <view>
          <text class="section-title">会员名单</text>
          <text class="section-note">{{loading && !initialized ? '正在更新' : total + ' 位符合条件'}}</text>
        </view>
        <text class="list-state">{{loading && !initialized ? '刷新中' : '点击查看档案'}}</text>
      </view>
      <block wx:if="{{list.length}}">
        <view wx:for="{{list}}" wx:key="id" class="member-list-item" data-id="{{item.id}}" bindtap="workspace_members_openDetail">
          <image class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view class="member-copy">
            <view class="member-name-row">
              <text class="item-title member-name">{{item.displayName}}</text>
              <text class="member-type">{{item.memberTypeText}}</text>
            </view>
            <text class="item-meta member-meta">{{item.metaText}}</text>
            <text class="item-meta member-meta">{{item.occupationText}}</text>
            <view class="member-status-row">
              <text class="status-text {{item.needsAttention ? 'attention' : ''}}">资料 {{item.profileCompletionText}}</text>
              <text class="status-divider">·</text>
              <text class="status-text">{{item.lastRecommendStatusText}}</text>
              <text class="status-divider">·</text>
              <text class="status-text">{{item.serviceLevelText}}</text>
            </view>
          </view>
          <view class="member-side">
            <text class="claim-state {{item.claimPending ? 'pending' : ''}}">{{item.identityStatusText}}</text>
            <text class="display-state">{{item.displayStatusText}}</text>
            <button class="more-btn" data-id="{{item.id}}" catchtap="workspace_members_toggleMemberActions">•••</button>
          </view>
          <view wx:if="{{activeMemberActionId === item.idText}}" class="member-action-panel" catchtap="workspace_members_holdTap">
            <button class="btn secondary compact-action" data-id="{{item.id}}" catchtap="workspace_members_openDetail">查看完整档案</button>
            <button class="btn danger compact-action" data-id="{{item.id}}" loading="{{removingId === item.idText}}" disabled="{{removingId === item.idText}}" catchtap="workspace_members_remove">移除会员</button>
          </view>
        </view>
      </block>
      <view wx:else class="empty">
        <text class="empty-title">{{loading && !initialized ? '正在加载会员' : '暂无会员'}}</text>
        <text class="empty-note">{{loading && !initialized ? '请稍候，正在整理会员列表。' : '先录入一位会员，建立第一份服务档案。'}}</text>
        <button wx:if="{{!loading}}" class="btn gold empty-action" bindtap="workspace_members_goAdd">录入第一位会员</button>
      </view>
      <view wx:if="{{hasMore}}">
        <text wx:if="{{paginationError}}" class="section-note">{{paginationError}}</text>
        <button class="btn ghost" loading="{{loadingMore}}" disabled="{{loadingMore || loading}}" bindtap="workspace_members_loadMore">{{loadingMore ? '正在加载更多会员' : '加载更多会员'}}</button>
      </view>
    </view>

    <view wx:if="{{refreshError}}" class="card notice-card">
      <text class="section-note">{{refreshError}}</text>
      <button class="btn ghost" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_members_refreshGate">重新加载</button>
    </view>

    <view class="card collaboration-card">
      <view class="collaboration-entry" bindtap="workspace_members_toggleRecommend">
        <view class="collaboration-copy">
          <text class="section-title">会员协作</text>
          <text class="section-note">名下会员互推与跨主理人资源</text>
        </view>
        <text class="collaboration-arrow">{{recommendOpen ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{recommendOpen}}" class="collaboration-body">
        <view class="collaboration-links">
          <button class="btn secondary" bindtap="workspace_members_goResources">浏览合作资源</button>
        </view>
        <text class="subsection-title">名下会员互推</text>
        <text class="section-note">选择两名会员，创建待跟进记录并通知双方。</text>
        <view class="recommend-select-grid">
          <picker wx:if="{{recommendAOptions.length}}" mode="selector" range="{{recommendAOptions}}" value="{{recommendAIndex}}" bindchange="workspace_members_onRecommendAChange">
            <view class="field recommend-picker">
              <text class="field-label">会员 A</text>
              <text class="field-input picker-value">{{recommendA.name || '请选择会员'}}</text>
            </view>
          </picker>
          <picker wx:if="{{recommendBOptions.length}}" mode="selector" range="{{recommendBOptions}}" value="{{recommendBIndex}}" bindchange="workspace_members_onRecommendBChange">
            <view class="field recommend-picker">
              <text class="field-label">会员 B</text>
              <text class="field-input picker-value">{{recommendB.name || '请选择会员'}}</text>
            </view>
          </picker>
        </view>
        <view class="recommend-pair">
          <view class="recommend-person {{recommendA.id ? '' : 'empty'}}">
            <text class="recommend-name">{{recommendA.name || '会员 A'}}</text>
            <text class="recommend-meta">{{recommendA.metaText || '请选择第一位会员'}}</text>
            <text class="recommend-meta">完整度 {{recommendA.completionText || '-'}}</text>
          </view>
          <view class="recommend-person {{recommendB.id ? '' : 'empty'}}">
            <text class="recommend-name">{{recommendB.name || '会员 B'}}</text>
            <text class="recommend-meta">{{recommendB.metaText || '请选择第二位会员'}}</text>
            <text class="recommend-meta">完整度 {{recommendB.completionText || '-'}}</text>
          </view>
        </view>
        <text class="recommend-hint">{{recommendHint}}</text>
        <button class="btn gold internal-recommend-btn" loading="{{recommendLoading}}" disabled="{{recommendLoading || !recommendReady}}" bindtap="workspace_members_recommendInternal">发起互推</button>
      </view>
    </view>
  </block>

  <view wx:else class="card approval-card">
    <view class="row approval-head">
      <view>
        <text class="section-title">会员管理待开通</text>
        <text class="section-note">{{statusNote}}</text>
      </view>
      <text class="tag {{statusTagClass}}">{{statusText}}</text>
    </view>
    <button wx:if="{{statusText === '已拒绝'}}" class="btn gold approval-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_members_applyAgain">重新提交申请</button>
    <button wx:if="{{refreshError || statusText === '待核验'}}" class="btn ghost approval-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_members_refreshGate">重新加载</button>
  </view>

</view>
</template>

<template name="messages">
<view class="page with-bottom-nav messages-page">
  <view class="messages-header">
    <view>
      <text class="eyebrow">会员沟通</text>
      <text class="title">消息</text>
      <text class="subtitle">{{loading ? '正在更新会话' : total + ' 个会话'}}</text>
    </view>
    <text class="pull-hint">下拉刷新</text>
  </view>

  <view class="card list-shell conversation-shell">
    <view class="row list-header">
      <view>
        <text class="section-title">最近会话</text>
        <text class="section-note">按最新消息排序</text>
      </view>
      <text wx:if="{{loading}}" class="loading-text">刷新中</text>
    </view>

    <block wx:if="{{list.length}}">
      <view wx:for="{{list}}" wx:key="id" class="list-card conversation-card" data-id="{{item.id}}" bindtap="workspace_messages_openChat">
        <image class="conversation-avatar" src="{{item.peerAvatar}}" mode="aspectFill"></image>
        <view class="conversation-copy">
          <view class="row conversation-title-row">
            <text class="item-title conversation-title">{{item.peerName}}</text>
            <text class="conversation-time">{{item.timeText}}</text>
          </view>
          <text class="item-meta conversation-preview">{{item.preview}}</text>
          <text class="conversation-type">{{item.typeText}}</text>
        </view>
        <text wx:if="{{item.hasUnread}}" class="unread-badge">{{item.unreadText}}</text>
      </view>
    </block>

    <view wx:else class="empty">
      <text class="empty-title">{{loading ? '正在加载消息' : emptyTitle}}</text>
      <text class="empty-note">{{loading ? '请稍候，正在整理你的会话。' : emptyNote}}</text>
      <button class="btn ghost empty-action" bindtap="workspace_messages_goMembers">去会员经营</button>
    </view>
  </view>

  <view wx:if="{{errorNote}}" class="card message-update-error">
    <text>{{errorNote}}</text>
    <button class="btn ghost" bindtap="workspace_messages_load">重试</button>
  </view>


</view>
</template>

<template name="salon">
<view class="page safe-bottom {{canOperate ? 'with-bottom-nav' : ''}}">
  <view class="salon-header">
    <view>
      <text class="eyebrow">活动管理</text>
      <text class="title">沙龙活动</text>
      <text class="subtitle">{{canOperate ? list.length + ' 场活动' : statusNote}}</text>
    </view>
    <button wx:if="{{canOperate}}" class="create-button" bindtap="workspace_salon_goCreate">＋ 创建活动</button>
  </view>

  <view wx:if="{{!canOperate}}" class="card approval-card">
    <view class="row approval-head">
      <view>
        <text class="section-title">活动权限待开通</text>
        <text class="section-note">{{statusNote}}</text>
      </view>
      <text class="tag {{statusTagClass}}">{{statusText}}</text>
    </view>
    <button wx:if="{{statusText === '已拒绝'}}" class="btn gold approval-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_salon_applyAgain">重新提交申请</button>
    <button wx:if="{{refreshError || statusText === '待核验'}}" class="btn ghost approval-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_salon_refreshGate">重新加载</button>
  </view>

  <block wx:if="{{canOperate}}">
    <view class="segment salon-segment">
      <button class="btn {{active === 'mine' ? 'active' : ''}}" disabled="{{loading}}" bindtap="workspace_salon_loadMine">我的活动</button>
      <button class="btn {{active === 'all' ? 'active' : ''}}" disabled="{{loading}}" bindtap="workspace_salon_loadAll">全部活动</button>
    </view>

    <view class="card list-shell salon-list-shell">
      <view class="row list-header">
        <view>
          <text class="section-title">{{active === 'mine' ? '我创建的活动' : '活动广场'}}</text>
          <text class="section-note">先查看时间、地点和报名状态</text>
        </view>
        <text class="list-state">{{loading && !initialized ? '刷新中' : list.length + ' 场'}}</text>
      </view>

      <block wx:if="{{list.length}}">
        <view wx:for="{{list}}" wx:key="id" class="salon-item">
          <view class="salon-main">
            <view class="salon-date-mark">
              <text class="date-icon">活</text>
            </view>
            <view class="salon-copy">
              <view class="row salon-title-row">
                <text class="item-title salon-title">{{item.title}}</text>
                <text class="status-chip">{{item.statusText}}</text>
              </view>
              <text class="item-meta">{{item.eventDateText}}</text>
              <text class="item-meta">{{item.locationText}}</text>
              <view class="salon-facts">
                <text class="salon-fact">{{item.participantText}}</text>
                <text class="salon-fact">{{item.seatText}}</text>
                <text class="salon-fact price">{{item.priceText}}</text>
              </view>
            </view>
          </view>

          <view wx:if="{{active === 'mine'}}" class="manage-entry" data-id="{{item.id}}" bindtap="workspace_salon_toggleEventManagement">
            <text>{{managingEventId === item.idText ? '收起管理操作' : '管理活动'}}</text>
            <text>{{managingEventId === item.idText ? '⌃' : '›'}}</text>
          </view>

          <view wx:if="{{active === 'mine' && managingEventId === item.idText}}" class="manage-panel">
            <block wx:if="{{item.canInvite}}">
              <text wx:if="{{loadingMembers}}" class="section-note">正在整理邀请名单</text>
              <view wx:if="{{memberOptionsError}}">
                <text class="section-note">{{memberOptionsError}}</text>
                <button class="btn ghost" bindtap="workspace_salon_loadMembers">重试名单</button>
              </view>
              <picker wx:if="{{memberOptions.length}}" disabled="{{loadingMembers}}" mode="selector" range="{{memberOptions}}" value="{{selectedMemberIndex}}" bindchange="workspace_salon_onInviteMemberChange">
                <view class="invite-picker">
                  <text class="field-label">推送给</text>
                  <text class="picker-value">{{selectedMemberName || '选择会员'}}</text>
                </view>
              </picker>
              <view class="invite-actions">
                <button class="btn gold invite-btn" data-id="{{item.id}}" loading="{{invitingId === item.idText + ':one'}}" disabled="{{invitingId || loadingMembers || !selectedMemberName}}" bindtap="workspace_salon_inviteSelected">推送选中会员</button>
                <button class="btn secondary invite-btn" data-id="{{item.id}}" loading="{{invitingId === item.idText + ':all'}}" disabled="{{invitingId || loadingMembers || !members.length}}" bindtap="workspace_salon_inviteAll">推送全部会员</button>
              </view>
              <button class="btn ghost share-btn" open-type="share" data-id="{{item.id}}" data-title="{{item.title}}">微信分享</button>
            </block>
            <text wx:else class="review-note">活动通过审核并开始报名后，可推送给名下会员。</text>
            <button class="cancel-link" data-id="{{item.id}}" loading="{{cancellingId === item.idText}}" disabled="{{cancellingId === item.idText}}" bindtap="workspace_salon_cancel">取消活动</button>
          </view>
        </view>
      </block>

      <view wx:else class="empty">
        <text class="empty-title">{{loading && !initialized ? '正在加载活动' : '暂无活动'}}</text>
        <text class="empty-note">{{loading && !initialized ? '请稍候，正在整理活动列表。' : '创建一场活动，会员即可查看和报名。'}}</text>
        <button wx:if="{{!loading && active === 'mine'}}" class="btn gold empty-action" bindtap="workspace_salon_goCreate">创建第一场活动</button>
      </view>
    </view>

    <view wx:if="{{refreshError}}" class="card notice-card">
      <text class="section-note">{{refreshError}}</text>
      <button class="btn ghost" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_salon_refreshGate">重新加载</button>
    </view>
  </block>


</view>
</template>

<template name="mine">
<view class="page safe-bottom {{canOperate ? 'with-bottom-nav' : ''}}">
  <view class="mine-header">
    <text class="eyebrow">我的</text>
    <text class="title">主理人中心</text>
  </view>

  <view class="card identity-card">
    <image wx:if="{{user.avatarUrl}}" class="identity-avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
    <view wx:else class="identity-avatar fallback">主</view>
    <view class="identity-copy">
      <view class="identity-name-row">
        <text class="identity-name">{{user.nickname || '主理人'}}</text>
        <text class="tag {{statusTagClass}}">{{statusText}}</text>
      </view>
      <text class="identity-number">{{dashboard.matchmaker.matchmakerNo || '专属编号待确认'}}</text>
      <text class="identity-note">{{canOperate ? '主理人等级 L' + (dashboard.matchmaker.level || 1) : statusNote}}</text>
    </view>
  </view>

  <view wx:if="{{canOperate}}" class="card invite-card">
    <view class="invite-entry" bindtap="workspace_mine_toggleInvite">
      <view class="invite-entry-copy">
        <text class="section-title">邀请会员</text>
        <text class="section-note">分享注册链接或邀请码</text>
      </view>
      <text class="invite-status">{{inviteCard.inviteCodeStatus === 'inactive' ? '已失效' : '有效'}}</text>
      <text class="invite-arrow">{{inviteOpen ? '⌃' : '›'}}</text>
    </view>

    <view wx:if="{{inviteOpen}}" class="invite-body">
      <view class="invite-panel">
        <view class="invite-code-box">
          <text class="field-label">邀请码</text>
          <text class="invite-code">{{inviteCard.inviteCode || '生成中'}}</text>
          <text class="invite-help">好友注册后会成为你的免费会员</text>
        </view>
        <view class="invite-qr-box" bindtap="workspace_mine_previewInviteQr">
          <image wx:if="{{inviteCard.qrCodeFileID}}" class="invite-qr" src="{{inviteCard.qrCodeFileID}}" mode="aspectFit"></image>
          <text wx:else class="invite-qr-placeholder">{{inviteLoading ? '生成中' : '二维码待生成'}}</text>
        </view>
      </view>
      <view class="button-row invite-actions">
        <button class="btn secondary" bindtap="workspace_mine_copyInviteCode">复制邀请码</button>
        <button class="btn gold" open-type="share">分享注册链接</button>
      </view>
      <button class="reset-link" loading="{{inviteResetting}}" disabled="{{inviteResetting}}" bindtap="workspace_mine_resetInviteCode">重置邀请码</button>
    </view>
  </view>

  <view class="card settings-card">
    <text class="section-title">账号设置</text>
    <view class="settings-list">
      <view class="settings-row">
        <text class="settings-label">认证状态</text>
        <text class="settings-value">{{statusText}}</text>
      </view>
      <view class="settings-row">
        <text class="settings-label">账号身份</text>
        <text class="settings-value">{{canOperate ? '认证主理人' : '申请中'}}</text>
      </view>
    </view>
    <text wx:if="{{!canOperate}}" class="settings-note">{{statusNote}}</text>
    <button wx:if="{{dashboard.matchmaker.certificationStatus === 1}}" class="btn secondary settings-action" loading="{{loading}}" disabled="{{loading}}" bindtap="workspace_mine_applyAgain">重新提交申请</button>
    <button class="logout-button" bindtap="workspace_mine_logout">{{canOperate ? '退出工作台' : '返回登录'}}</button>
  </view>


</view>
</template>

<view class="matchmaker-workspace-body workspace-{{activeTab}}">
  <template is="{{activeTab}}" data="{{...view}}"></template>
</view>
<bottom-nav role="matchmaker" active="{{activeTab}}" embedded bind:change="onTabChange"></bottom-nav>
