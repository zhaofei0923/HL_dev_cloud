.workspace-salon .invite-btn { height: 68rpx; font-size: 22rpx; line-height: 68rpx; }
.workspace-salon .share-btn { height: 66rpx; margin-top: 10rpx; font-size: 22rpx; line-height: 66rpx; }
.workspace-salon .review-note { display: block; color: #806d5e; font-size: 22rpx; line-height: 1.5; }

.workspace-salon .cancel-link {
  width: 100%;
  height: 60rpx;
  margin: 12rpx 0 0;
  padding: 0;
  border: 0;
  border-top: 1rpx solid rgba(151, 119, 82, 0.12);
  border-radius: 0;
  background: transparent;
  color: #9b4d47;
  font-size: 22rpx;
  line-height: 60rpx;
}

/* mine */
.workspace-mine .mine-header { padding: 14rpx 4rpx 24rpx; }
.workspace-mine .mine-header .eyebrow,
.workspace-mine .mine-header .title { display: block; }
.workspace-mine .mine-header .eyebrow { color: #a17750; }
.workspace-mine .mine-header .title { margin-top: 6rpx; font-size: 40rpx; }

.workspace-mine .identity-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.workspace-mine .identity-avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  background: #eee3d7;
}

.workspace-mine .identity-avatar.fallback { color: #775139; font-size: 34rpx; font-weight: 900; }
.workspace-mine .identity-copy { flex: 1; min-width: 0; }
.workspace-mine .identity-name-row { display: flex; align-items: center; gap: 12rpx; }
.workspace-mine .identity-name { min-width: 0; color: #302923; font-size: 32rpx; font-weight: 800; }
.workspace-mine .identity-number,
.workspace-mine .identity-note { display: block; }
.workspace-mine .identity-number { margin-top: 9rpx; color: #776d65; font-size: 23rpx; }
.workspace-mine .identity-note { margin-top: 5rpx; color: #9a7252; font-size: 21rpx; }

.workspace-mine .invite-card { padding: 0 24rpx; }
.workspace-mine .invite-entry { display: flex; align-items: center; gap: 14rpx; min-height: 104rpx; }
.workspace-mine .invite-entry-copy { flex: 1; min-width: 0; }
.workspace-mine .invite-status { color: #61705b; font-size: 21rpx; font-weight: 700; }
.workspace-mine .invite-arrow { color: #9b8f85; font-size: 30rpx; }
.workspace-mine .invite-body { padding: 20rpx 0 24rpx; border-top: 1rpx solid rgba(151, 119, 82, 0.12); }
.workspace-mine .invite-panel { display: flex; gap: 16rpx; }

.workspace-mine .invite-code-box,
.workspace-mine .invite-qr-box { box-sizing: border-box; border: 1rpx solid rgba(151, 119, 82, 0.14); border-radius: 12rpx; background: #faf7f2; }
.workspace-mine .invite-code-box { flex: 1; min-width: 0; padding: 18rpx; }
.workspace-mine .invite-code { display: block; margin-top: 7rpx; color: #302923; font-size: 31rpx; font-weight: 900; word-break: break-all; }
.workspace-mine .invite-help { display: block; margin-top: 10rpx; color: #8a8179; font-size: 20rpx; line-height: 1.45; }
.workspace-mine .invite-qr-box { display: flex; flex: 0 0 170rpx; align-items: center; justify-content: center; width: 170rpx; min-height: 170rpx; padding: 12rpx; }
.workspace-mine .invite-qr { width: 146rpx; height: 146rpx; }
.workspace-mine .invite-qr-placeholder { color: #857a71; font-size: 21rpx; text-align: center; }
.workspace-mine .invite-actions { margin-top: 16rpx; }

.workspace-mine .reset-link,
.workspace-mine .logout-button {
  width: 100%;
  height: 66rpx;
  margin: 12rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 23rpx;
  line-height: 66rpx;
}

.workspace-mine .reset-link { color: #8a6a50; }
.workspace-mine .settings-card { margin-bottom: 0; }
.workspace-mine .settings-list { margin-top: 16rpx; border-top: 1rpx solid rgba(151, 119, 82, 0.12); }
.workspace-mine .settings-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 78rpx; border-bottom: 1rpx solid rgba(151, 119, 82, 0.1); }
.workspace-mine .settings-label { color: #514941; font-size: 25rpx; }
.workspace-mine .settings-value { color: #8b8179; font-size: 23rpx; }
.workspace-mine .settings-note { display: block; margin-top: 16rpx; color: #806d5e; font-size: 22rpx; line-height: 1.5; }
.workspace-mine .settings-action { margin-top: 18rpx; }
.workspace-mine .logout-button { margin-top: 16rpx; border-top: 1rpx solid rgba(151, 119, 82, 0.12); color: #9b4d47; }
