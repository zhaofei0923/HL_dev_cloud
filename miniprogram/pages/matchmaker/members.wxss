.members-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 4rpx 26rpx;
}

.members-heading {
  flex: 1;
  min-width: 0;
}

.members-heading .eyebrow,
.members-heading .title,
.members-heading .subtitle {
  display: block;
}

.members-heading .eyebrow { color: #a17750; }
.members-heading .title { margin-top: 6rpx; font-size: 40rpx; }
.members-heading .subtitle { margin-top: 6rpx; color: #81776f; font-size: 24rpx; }

.add-member-btn {
  flex: none;
  min-width: 190rpx;
  height: 76rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 14rpx;
  background: #8a6243;
  color: #fffdf8;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.add-member-btn::after,
.search-submit::after,
.more-btn::after {
  border: 0;
}

.search-card { padding: 20rpx; }

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 76rpx;
  padding-left: 18rpx;
  border: 1rpx solid rgba(151, 119, 82, 0.14);
  border-radius: 14rpx;
  background: #f8f5f0;
}

.search-icon { flex: none; color: #9a8c80; font-size: 30rpx; }
.search-input { flex: 1; min-width: 0; height: 76rpx; color: #2f2924; font-size: 27rpx; }

.search-submit {
  flex: none;
  width: 116rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0 14rpx 14rpx 0;
  background: #8a6243;
  color: #fffdf8;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.quick-filter-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6rpx;
  margin-top: 14rpx;
  padding: 5rpx;
  border-radius: 14rpx;
  background: #f3eee8;
}

.quick-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 58rpx;
  border-radius: 11rpx;
  color: #776d65;
  font-size: 23rpx;
  font-weight: 700;
}

.quick-filter.active { background: #fffdf8; color: #765238; box-shadow: 0 4rpx 12rpx rgba(70, 54, 43, 0.08); }
.filter-trigger { border-left: 1rpx solid rgba(151, 119, 82, 0.12); }
.advanced-filters { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(151, 119, 82, 0.12); }
.filter-field, .picker-field { margin: 0; }

.filter-grid,
.recommend-select-grid,
.recommend-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.filter-actions { margin-top: 14rpx; }
.picker-value { display: block; line-height: 1.45; }

.notice-entry {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 88rpx;
  margin-bottom: 18rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(180, 129, 79, 0.2);
  border-radius: 14rpx;
  background: #fcf7ef;
}

.notice-entry.open { margin-bottom: 10rpx; }
.notice-dot { flex: none; width: 12rpx; height: 12rpx; border-radius: 50%; background: #a86645; }
.notice-copy { flex: 1; min-width: 0; }
.notice-title, .notice-note { display: block; }
.notice-title { color: #4a382c; font-size: 26rpx; font-weight: 800; }
.notice-note { margin-top: 3rpx; color: #8a7768; font-size: 21rpx; }

.notice-count {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #a86645;
  color: #fffdf8;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-align: center;
}

.notice-arrow { color: #9b8f85; font-size: 30rpx; }
.request-card { padding-top: 10rpx; padding-bottom: 10rpx; }
.request-item { padding: 18rpx 0; border-top: 1rpx solid rgba(151, 119, 82, 0.12); }
.request-item:first-child { border-top: 0; }
.request-actions { display: flex; gap: 12rpx; margin-top: 14rpx; }
.small-btn { height: 66rpx; font-size: 24rpx; line-height: 66rpx; }

.members-list-shell { padding: 20rpx 22rpx; }
.list-header { align-items: flex-start; }
.list-state { color: #95877d; font-size: 21rpx; }

.member-list-item {
  position: relative;
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr) 126rpx;
  gap: 16rpx;
  align-items: flex-start;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(151, 119, 82, 0.12);
}

.member-list-item:first-of-type { margin-top: 12rpx; }
.member-avatar { width: 96rpx; height: 96rpx; border-radius: 16rpx; background: #eee6dc; }
.member-copy { min-width: 0; }
.member-name-row { display: flex; align-items: center; gap: 10rpx; }
.member-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.member-type { flex: none; padding: 4rpx 9rpx; border-radius: 8rpx; background: #f1e9df; color: #765238; font-size: 19rpx; font-weight: 700; }
.member-meta { margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.member-status-row { display: flex; align-items: center; gap: 7rpx; margin-top: 10rpx; overflow: hidden; white-space: nowrap; }
.status-text, .status-divider { color: #887c72; font-size: 20rpx; }
.status-text.attention { color: #a15b40; font-weight: 700; }
.status-divider { color: #c6bdb5; }
.member-side { display: flex; flex-direction: column; align-items: flex-end; }
.display-state { margin-top: 9rpx; color: #6f765f; font-size: 21rpx; font-weight: 700; }

.more-btn {
  width: 76rpx;
  height: 54rpx;
  margin: 10rpx 0 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #8c8178;
  font-size: 24rpx;
  line-height: 54rpx;
}

.claim-state {
  flex: none;
  padding: 5rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(102, 114, 95, 0.11);
  color: #596553;
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
}

.claim-state.pending {
  background: rgba(154, 106, 69, 0.12);
  color: #8a5f3e;
}

.member-action-panel { grid-column: 1 / -1; display: flex; gap: 12rpx; padding: 14rpx; border-radius: 12rpx; background: #f7f3ee; }
.compact-action { height: 66rpx; font-size: 23rpx; line-height: 66rpx; }
.empty-action { margin-top: 20rpx; }
.collaboration-card { padding: 0 24rpx; }

.collaboration-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 104rpx;
}

.collaboration-copy { flex: 1; min-width: 0; }
.collaboration-arrow { color: #9a6d48; font-size: 23rpx; font-weight: 700; }
.collaboration-body { padding: 0 0 24rpx; border-top: 1rpx solid rgba(151, 119, 82, 0.12); }
.collaboration-links { margin: 18rpx 0 24rpx; }
.subsection-title { display: block; color: #3a3029; font-size: 27rpx; font-weight: 800; }
.recommend-picker { margin: 0; }

.recommend-person {
  box-sizing: border-box;
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid rgba(151, 119, 82, 0.13);
  border-radius: 12rpx;
  background: #fbf8f3;
}

.recommend-person.empty { background: #f4f1ec; }
.recommend-name, .recommend-meta { display: block; }
.recommend-name { color: #2f2924; font-size: 26rpx; font-weight: 800; }
.recommend-meta { margin-top: 7rpx; color: #81766d; font-size: 21rpx; line-height: 1.4; }
.recommend-hint { display: block; margin-top: 16rpx; color: #806d5e; font-size: 22rpx; }
.internal-recommend-btn, .approval-btn { margin-top: 18rpx; }
.approval-head { align-items: flex-start; }
