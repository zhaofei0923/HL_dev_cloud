.bottom-nav-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  box-sizing: border-box;
  width: 100%;
  padding: 6rpx 18rpx calc(6rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(151, 119, 82, 0.12);
  background: rgba(255, 253, 249, 0.97);
  backdrop-filter: blur(14rpx);
  box-shadow: 0 -3rpx 12rpx rgba(56, 42, 29, 0.035);
}

.bottom-nav {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 92rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  overflow: hidden;
}

.bottom-nav-admin {
  display: flex;
}

.bottom-nav-matchmaker {
  display: flex;
}

.bottom-nav-item {
  box-sizing: border-box;
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 0;
  min-width: 0;
  height: 92rpx;
  margin: 0;
  padding: 5rpx 4rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #2b2420;
  line-height: 1;
}

.bottom-nav-item::after {
  border: 0;
}

.bottom-nav-hover {
  background: rgba(163, 93, 69, 0.06);
}

.bottom-nav-item.active {
  color: #a35d45;
  background: rgba(163, 93, 69, 0.075);
  box-shadow: inset 0 3rpx 0 #a35d45;
}

.bottom-nav-label {
  display: block;
  flex: 0 0 28rpx;
  width: 100%;
  height: 28rpx;
  max-width: 100%;
  color: currentColor;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  white-space: nowrap;
}

.nav-icon {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.nav-icon-image {
  display: block;
  width: 48rpx;
  height: 48rpx;
}
